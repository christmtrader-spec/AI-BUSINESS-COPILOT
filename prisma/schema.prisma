// AI Business Copilot — Schema v1 (Phase 01: Foundation)
// Constitution: A01 multi-tenant, A02 RBAC, A04 currency, A07 UTC dates,
// A08 money as integer minor units (Int), A09 auditability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite connector does not support Prisma enums.
// Roles are stored as strings; the authoritative set lives in
// src/lib/rbac.ts and is validated with zod at every boundary.

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String
  locale          String    @default("en") // user display preference (A05)
  // Prompt 18 session security: bumped on password change / password reset /
  // account security events. JWTs carry the version they were issued with;
  // a mismatch means the session was invalidated and must re-authenticate.
  sessionVersion  Int       @default(0)
  // Prompt 30 §3 — email ownership verification. NULL = not verified;
  // non-null = verified. NEVER inferred from email formatting, and existing
  // accounts are NOT bulk-marked verified (§225 — no evidence exists).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships          BusinessMember[]
  ownedBusinesses      Business[]            @relation("BusinessOwner")
  auditLogs            AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  payments             Payment[]
  invitesCreated       BusinessInvite[]      @relation("InviteCreator")
  invitesAccepted      BusinessInvite[]      @relation("InviteAcceptor")
  chatSessions         ChatSession[]
  chatMessages         ChatMessage[]
  passwordResetTokens  PasswordResetToken[]
  subscriptionEvents   SubscriptionEvent[]
  legalAcceptances     LegalAcceptance[]
  platformOperator     PlatformOperator?

  // Prompt 30 — identity security v2 (§294). All cascade with the user so
  // account deletion removes every user-owned security record (§295).
  emailVerificationTokens EmailVerificationToken[]
  mfaCredential           MfaCredential?
  mfaRecoveryCodes        MfaRecoveryCode[]
  mfaLoginChallenges      MfaLoginChallenge[]
  sessions                UserSession[]
  securityEvents          SecurityEvent[]

  // Prompt 32 — unified notification platform (§16/§20).
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // Prompt 35 — Advanced CRM Foundation (§9/§11): explicit relation names
  // avoid Prisma ambiguity (both CRM models reference User).
  crmLeadAssignments        CrmLead[]        @relation("CrmLeadAssignee")
  crmOpportunityAssignments CrmOpportunity[] @relation("CrmOpportunityAssignee")

  // Prompt 36 — CRM Activities + Tasks (§5/§7/§61): explicit relation names
  // for the three User references (creator of activities, assignee and
  // creator of tasks). Activity/task creators are Restrict — a user with
  // created CRM records follows the existing account-deletion policy
  // (documented in docs/legal/data-deletion-matrix.md before migration).
  crmActivityCreations CrmActivity[] @relation("CrmActivityCreator")
  crmTaskCreations     CrmTask[]     @relation("CrmTaskCreator")
  crmTaskAssignments   CrmTask[]     @relation("CrmTaskAssignee")

  // Prompt 40 — Inventory Stocktake (§11/§13): explicit relation names for
  // the two User references (stocktake creator, line counter). Both are
  // Restrict — the same creator-linked policy as CRM (documented in
  // docs/legal/data-deletion-matrix.md BEFORE the migration).
  inventoryStocktakeCreations InventoryStocktake[]     @relation("InventoryStocktakeCreator")
  inventoryStocktakeCounts    InventoryStocktakeLine[] @relation("InventoryStocktakeCounter")
  // Prompt 41 — Purchase Orders (§6): creator link is Restrict — the same
  // creator-linked policy as CRM/P40 (documented in the deletion matrix).
  purchaseOrderCreations      PurchaseOrder[]          @relation("PurchaseOrderCreator")
  // Prompt 42 — Goods Receipts (§21): creator link is Restrict — the same
  // creator-linked policy as P40/P41 (documented in the deletion matrix).
  goodsReceiptCreations       GoodsReceipt[]           @relation("GoodsReceiptCreator")
  // Prompt 43 — Goods Returns (§24): creator link is Restrict — the same
  // creator-linked policy as P40/P41/P42 (documented in the deletion matrix).
  goodsReturnCreations        GoodsReturn[]            @relation("GoodsReturnCreator")
  goodsDispatchCreations      GoodsDispatch[]          @relation("GoodsDispatchCreator")
  // Prompt 45 — Sales Orders (§6/§68): creator link is Restrict — the same
  // creator-linked policy as P40–P44 (documented in the deletion matrix).
  salesOrderCreations         SalesOrder[]             @relation("SalesOrderCreator")
  // Prompt 47 — Sales Quotations: creator link is Restrict — the same
  // creator-linked policy as P40–P45 (documented in the deletion matrix).
  salesQuotationCreations     SalesQuotation[]         @relation("SalesQuotationCreator")
  // Prompt 48 — Supplier Bills: creator link is Restrict — the same
  // creator-linked policy as P40–P47 (documented in the deletion matrix).
  supplierBillCreations       SupplierBill[]           @relation("SupplierBillCreator")
  // Prompt 52 — public API keys: creator link is Restrict (integration
  // evidence survives the creator's departure; keys die with the business).
  apiKeyCreations             ApiKey[]                 @relation("ApiKeyCreator")
  webhookCreations            WebhookEndpoint[]        @relation("WebhookCreator")
}

// ---------------------------------------------------------------------------
// Prompt 30 — email ownership verification (§4). ONLY the SHA-256 HASH of a
// one-time verification token is stored; the raw token exists exclusively
// inside the emailed link. Single active token per user is enforced in the
// service layer (outstanding tokens are invalidated when a new one is issued,
// §7). Purpose-separated from PasswordResetToken (§314/§315): a verification
// token can never reset a password and vice versa.
// ---------------------------------------------------------------------------
model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Prompt 30 — TOTP MFA credential (§32). The TOTP secret is stored ENCRYPTED
// (AES-256-GCM secret-box; key lives ONLY in the MFA_ENCRYPTION_KEY env var,
// never in the database §33/§34). enabledAt NULL = pending setup (never
// trusted by login — §38); non-null = active. userId unique guarantees at
// most one credential per user (§213).
// ---------------------------------------------------------------------------
model MfaCredential {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret  String
  // secret-box format version (§35/§191 — future key rotation, documented).
  secretVersion    Int       @default(1)
  enabledAt        DateTime?
  // Replay protection state (§45): the last TOTP time-step accepted at login.
  // A code from the same (or older) step can never be accepted twice. NULL
  // until the first successful login after enrollment.
  lastUsedTotpStep Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, enabledAt])
}

// ---------------------------------------------------------------------------
// Prompt 30 — one-time MFA recovery codes (§59). Hash-only persistence
// (SHA-256 of the normalized code — high-entropy random, never a user
// secret worth a slow hash). Single use is claimed atomically (§62).
// ---------------------------------------------------------------------------
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// ---------------------------------------------------------------------------
// Prompt 30 — short-lived pre-auth MFA login challenge (§47). Password
// success alone NEVER creates a session when MFA is enabled (§54): the
// client receives only this bounded challenge. Hash-only storage; single
// use claimed atomically (§50); bound to the user's sessionVersion so a
// password change mid-challenge kills the challenge (§437/§438). The one-
// time assertion hash (§53) is stored here after successful code
// verification and consumed inside NextAuth authorize().
// ---------------------------------------------------------------------------
model MfaLoginChallenge {
  id                        String    @id @default(cuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash             String    @unique
  expiresAt                 DateTime
  usedAt                    DateTime?
  attemptCount              Int       @default(0)
  assertionHash             String?   @unique
  assertionUsedAt           DateTime?
  sessionVersionAtChallenge Int
  createdAt                 DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Prompt 30 — server-side session registry (§70). JWTs remain the transport;
// this table adds per-device revocation. sessionTokenHash = SHA-256(sid) —
// the raw sid/JWT is NEVER stored (§71/§72). IP is stored HASHED (§75 — the
// choice and its limits are documented; this is not strong anonymization).
// ---------------------------------------------------------------------------
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  // Bounded user-agent snapshot (max 255 chars, §233) and derived safe
  // device label (e.g. "Chrome on Windows" — never a fingerprint, §74/§232).
  userAgent        String?
  deviceLabel      String?
  ipHash           String?
  createdFrom      String    @default("login")
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Prompt 30 — durable security activity (§89). FIXED event vocabulary only
// (§423 — never client-supplied). No secrets, no OTP, no raw IPs, no bodies
// (§90). Cascade-deleted with the user: security history does NOT survive
// account deletion (privacy-first choice, documented §295/§296).
// ---------------------------------------------------------------------------
model SecurityEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String
  sessionId  String?
  ipHash     String?
  userAgent  String?
  success    Boolean
  reasonCode String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 18 — credential recovery. ONLY the SHA-256 HASH of a one-time reset
// token is stored (the raw token lives exclusively inside the emailed link).
// Tokens are single-use (usedAt), short-lived (expiresAt, 30 minutes) and
// cleaned up opportunistically. requestedIp/userAgent support security
// review of recovery abuse; they never contain secrets.
// ---------------------------------------------------------------------------
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Business {
  id               String @id @default(cuid())
  name             String
  slug             String @unique
  // A04 — currency is configuration, never hard-coded
  currencyCode     String @default("USD")
  currencySymbol   String @default("$")
  decimalPrecision Int    @default(2) // 0..4
  // A05/A07 — locale & timezone are business configuration
  locale           String @default("en")
  timezone         String @default("UTC")
  // Prompt 52 — VAT engine (official Iranian invoices). Basis points keep
  // the rate integer (1000 bp = 10%); vatEnabled=false keeps legacy behavior
  // (taxMinor always 0). The rate is a CONFIG value; the per-sale snapshot is
  // authoritative for each issued invoice (stable reprints).
  vatEnabled       Boolean @default(false)
  vatRateBp        Int     @default(0)

  ownerId String
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id])

  members              BusinessMember[]
  auditLogs            AuditLog[]
  invites              BusinessInvite[]
  customers            Customer[]
  suppliers            Supplier[]
  products             Product[]
  inventoryAdjustments InventoryAdjustment[]
  sales                Sale[]
  expenses             Expense[]
  payments             Payment[]
  chatSessions         ChatSession[]
  subscription         Subscription?
  subscriptionEvents   SubscriptionEvent[]
  usagePeriods         UsagePeriod[]
  usageEvents          UsageEvent[]
  checkoutSessions     CheckoutSession[]
  // Prompt 31 — customer data portability jobs (tenant-scoped, cascade).
  dataExportJobs       DataExportJob[]
  dataImportJobs       DataImportJob[]
  // Prompt 32 — business-scoped notifications (cascade, §200).
  notifications        Notification[]
  // Prompt 35 — Advanced CRM Foundation (§8/§11).
  crmLeads             CrmLead[]
  crmOpportunities     CrmOpportunity[]
  // Prompt 36 — CRM Activities + Tasks (§4): tenant-scoped, cascade.
  crmActivities        CrmActivity[]
  crmTasks             CrmTask[]
  // Prompt 40 — physical stock-count sessions (tenant-scoped, cascade).
  inventoryStocktakes  InventoryStocktake[]
  // Prompt 41 — procurement commitment documents (tenant-scoped, cascade).
  purchaseOrders       PurchaseOrder[]
  // Prompt 42 — goods receipt documents (tenant-scoped, cascade; §22).
  goodsReceipts        GoodsReceipt[]
  // Prompt 43 — goods return documents (tenant-scoped, cascade; §25).
  goodsReturns         GoodsReturn[]
  // Prompt 44 — goods dispatch documents (tenant-scoped, cascade).
  goodsDispatches      GoodsDispatch[]
  // Prompt 45 — commercial customer orders (tenant-scoped, cascade; §10).
  salesOrders          SalesOrder[]
  // Prompt 47 (§5) — commercial price offers (tenant-scoped, cascade):
  // deleting the business deletes its quotations.
  salesQuotations      SalesQuotation[]
  // Prompt 52 — public API keys for external accounting integrations.
  apiKeys              ApiKey[]
  // Prompt 53 §W — outbound webhook endpoints (event-driven integrations).
  webhookEndpoints     WebhookEndpoint[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplierBills SupplierBill[]

  @@index([ownerId])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One of: OWNER | ADMIN | MANAGER | STAFF | ACCOUNTANT | VIEWER (rbac.ts)
  role       String   @default("VIEWER")
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

// Phase 06+ — invite links (no email sending in MVP scope): an OWNER/ADMIN
// mints a one-time token link; the invitee opens #/join/<token>, previews
// the business + role and accepts. Roles/audit identical to member.add.
model BusinessInvite {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Opaque 48-char token; unique lookup by token — never guessable.
  token        String    @unique
  // OWNER is intentionally NOT grantable via invites (see rbac.ts).
  role         String    @default("VIEWER")
  createdById  String?
  createdBy    User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedById String?
  acceptedBy   User?     @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([businessId, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  // Nullable since Prompt 18: account-level security events (password
  // change/reset, account deletion) are not bound to a business.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "business.update", "member.role_change"
  entityType String // e.g. "Business", "BusinessMember"
  entityId   String?
  beforeJson String?
  afterJson  String?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Phase 02 — Master data (Constitution MVP scope §2 items 5-7, 13)
// Financial records use soft delete (deletedAt); money is Int minor units.
// ---------------------------------------------------------------------------

model Customer {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  address    String?
  note       String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sales Sale[]

  // Prompt 35 — CRM links (§11): a lead points at the customer it converted
  // into; an opportunity may reference an existing customer. Both are
  // SetNull so deleting a customer never breaks CRM history rows.
  crmLeads         CrmLead[]
  crmOpportunities CrmOpportunity[]
  // Prompt 36 (§4/§61) — CRM activity/task contexts. SetNull: deleting the
  // customer (hard cascade path) detaches history rows but never destroys
  // them; the normal UI soft-delete hides them from active timelines.
  crmActivities    CrmActivity[]
  crmTasks         CrmTask[]
  // Prompt 44 — dispatch history rows pointing at this customer. SetNull:
  // deleting the customer detaches the link but never destroys history.
  goodsDispatches  GoodsDispatch[]
  // Prompt 45 (§11/§12) — commercial orders for this customer. SetNull:
  // the frozen customerNameAtOrder snapshot keeps every order readable
  // even when the live relation later detaches.
  salesOrders      SalesOrder[]
  // Prompt 47 (§5/§12) — quotations offered to this customer. SetNull: the
  // frozen customerNameAtQuotation snapshot keeps every quotation readable
  // even when the live relation later detaches (same law as SalesOrder).
  salesQuotations  SalesQuotation[]

  @@index([businessId, deletedAt])
  @@index([businessId, name])
}

// (Prompt 48 — Supplier model gains supplierBills below in its own block.)

model Supplier {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  address    String?
  note       String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expenses       Expense[]
  // Prompt 41 — procurement documents issued to this supplier (cascade on
  // tenant; the supplier FK itself is Restrict so hard-deleting a supplier
  // with documents can never silently destroy procurement history §234 —
  // the API only ever soft-deletes suppliers).
  purchaseOrders PurchaseOrder[]
  // Prompt 48 — supplier invoice documents issued by this supplier. Restrict
  // mirrors PurchaseOrder: the supplier row must outlive its bill documents;
  // the API only ever soft-deletes suppliers (the frozen supplierNameAtBill
  // snapshot keeps every bill readable regardless).
  supplierBills  SupplierBill[]

  @@index([businessId, deletedAt])
  @@index([businessId, name])
}

model Product {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  unit           String? // e.g. piece, kg, hour
  // A08 — prices stored as integer minor units (never floats)
  salePriceMinor Int       @default(0)
  costPriceMinor Int       @default(0)
  // Basic inventory: current stock quantity in whole units
  stockQty       Int       @default(0)
  lowStockAt     Int       @default(5) // threshold for low-stock alert
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  adjustments             InventoryAdjustment[]
  saleItems               SaleItem[]
  // Prompt 40 — physical count lines that snapshotted this product.
  inventoryStocktakeLines InventoryStocktakeLine[]
  // Prompt 41 — procurement lines that snapshotted this product (the line
  // keeps its own historical snapshot; §26/§27).
  purchaseOrderLines      PurchaseOrderLine[]
  // Prompt 42 — receipt lines that moved this product's stock (the line
  // keeps its own historical snapshot; §28-§30).
  goodsReceiptLines       GoodsReceiptLine[]
  // Prompt 43 — return lines that moved this product's stock back to the
  // supplier (the line keeps its own historical snapshot; §30).
  goodsReturnLines        GoodsReturnLine[]
  // Prompt 44 — dispatch lines that moved this product's stock out (the
  // line keeps its own historical snapshot).
  goodsDispatchLines      GoodsDispatchLine[]
  // Prompt 45 (§20) — order lines that commit to this product (the line
  // keeps its own historical snapshot; Restrict mirrors P41–P44).
  salesOrderLines         SalesOrderLine[]
  // Prompt 47 (§6) — quotation lines that offered this product (the line
  // keeps its own historical snapshot; Restrict mirrors P41–P45 — a hard
  // product delete can never silently destroy quotation evidence).
  salesQuotationLines     SalesQuotationLine[]
  // Prompt 48 (§6) — bill lines that invoiced this product (the line keeps
  // its own historical snapshot; Restrict mirrors P41–P47 — a hard product
  // delete can never silently destroy posted bill history).
  supplierBillLines       SupplierBillLine[]

  @@index([businessId, deletedAt])
  @@index([businessId, name])
}

model InventoryAdjustment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta      Int // signed change in units
  reason     String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 40 — Inventory Stocktake (§10-§14): controlled physical counting.
// InventoryStocktake = one physical count session (per business).
// InventoryStocktakeLine = one product physically counted within a session
// (unique stocktakeId+productId, DB-enforced §14/§28/§48).
// The stocktake is NOT an accounting construct (§3): finalization only
// reconciles Product.stockQty through the EXISTING InventoryAdjustment
// semantics (§43) — never Sale/Expense/Payment/Statement/CRM.
// ---------------------------------------------------------------------------
model InventoryStocktake {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §22 — required, 2..80 chars, unique per business (DB-enforced).
  reference String
  // §8 — closed lifecycle: DRAFT | COUNTING | REVIEW | FINALIZED | CANCELLED
  // (transitions are server-authoritative, §9).
  status    String  @default("DRAFT")
  // §7 — closed vocabulary; only SELECTED exists in Prompt 40.
  countType String  @default("SELECTED")
  // §23 — optional free text (≤2000 chars); never logged, never sent to AI.
  notes     String?

  createdByUserId String
  createdByUser   User   @relation("InventoryStocktakeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  startedAt   DateTime?
  reviewedAt  DateTime?
  finalizedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InventoryStocktakeLine[]

  @@unique([businessId, reference])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, createdByUserId])
}

model InventoryStocktakeLine {
  id String @id @default(cuid())

  stocktakeId String
  stocktake   InventoryStocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §15 — server-side snapshot of Product.stockQty AT COUNT TIME (never
  // client-supplied). Finalization stale-check compares this against the
  // CURRENT stockQty (§39/§40) — never rebased (§41).
  systemQtyAtCount Int
  // §16 — client supplies ONLY countedQty; variance is server-derived.
  countedQty       Int
  varianceQty      Int // countedQty - systemQtyAtCount (sign is meaningful, §18)

  countedAt       DateTime
  countedByUserId String
  countedByUser   User     @relation("InventoryStocktakeCounter", fields: [countedByUserId], references: [id], onDelete: Restrict)

  // §19 — product metadata snapshot for historical understandability
  // (NOT sale/cost prices).
  productNameAtCount String
  skuAtCount         String?
  unitAtCount        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stocktakeId, productId])
  @@index([stocktakeId])
  @@index([productId])
  @@index([countedAt])
}

// ---------------------------------------------------------------------------
// Phase 03 — Transactions (Constitution MVP scope items 8-12)
// Money = Int minor units (A08). `paidMinor` + `status` on Sale/Expense are
// denormalized summaries maintained transactionally with every Payment write
// (single writer path: the payments pipeline). Status values:
// UNPAID | PARTIAL | PAID — computed by lib/money.statusOf, never client input.
// ---------------------------------------------------------------------------

model Sale {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Per-business sequential invoice number (displayed as INV-0001)
  number        Int
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Totals computed server-side with integer math at creation (A08).
  // Law: totalMinor = subtotalMinor - discountMinor + taxMinor (integer math).
  // Legacy rows have taxMinor=0 so the old identity still holds.
  subtotalMinor Int
  discountMinor Int       @default(0)
  taxRateBp     Int       @default(0) // VAT snapshot in basis points (1000 = 10%) at issuance
  taxMinor      Int       @default(0) // VAT amount snapshot in minor units
  totalMinor    Int
  // Payment summary — updated in the same tx as every Payment create/delete
  paidMinor     Int       @default(0)
  status        String    @default("UNPAID")
  issueDate     DateTime  @default(now())
  note          String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    SaleItem[]
  payments Payment[]

  // Prompt 45 (§52) — the ONE order-linked invoice (one-to-one; nullable
  // for every legacy direct sale). Unique constraint is the DATABASE
  // authority behind "one invoice per order" (§52/§105). SetNull: removing
  // the order (business cascade) must never destroy invoice evidence.
  salesOrderId String?     @unique
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  @@unique([businessId, number])
  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, status])
  @@index([customerId])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String // snapshot of product/custom item name at sale time
  unit           String? // snapshot
  qty            Int // whole units (MVP contract)
  unitPriceMinor Int
  lineTotalMinor Int // qty * unitPriceMinor, integer math

  @@index([saleId])
}

model Expense {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category    String
  amountMinor Int
  paidMinor   Int       @default(0)
  status      String    @default("UNPAID")
  spentAt     DateTime  @default(now())
  // Supplier-bill terms (payables aging): date-only semantics — parsed with
  // the Prompt-35 §84 UTC-midnoon rule so the calendar day is stable across
  // display timezones. Null = no stated due date (aging anchors on spentAt).
  dueDate     DateTime?
  // Free-text supplier bill/invoice reference (max 80, trimmed).
  reference   String?
  note        String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments     Payment[]
  // Prompt 48 — AT MOST ONE supplier bill may link this Expense as its
  // posted payable (P48 §2: the bill is the document authority; the Expense
  // stays the sole financial liability authority). SetNull: the FK only ever
  // fires at business-cascade deletion, where the bill row is being removed
  // by the same cascade — a user-facing delete of a linked Expense is
  // blocked by the API (SUPPLIER_BILL_LINKED_EXPENSE_IMMUTABLE).
  supplierBill SupplierBill?

  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, status])
  @@index([supplierId])
  @@index([businessId, dueDate])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Exactly one of saleId / expenseId (validated in the API schema)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  direction   String // IN (customer pays us) | OUT (we pay supplier)
  amountMinor Int
  method      String // CASH | BANK_TRANSFER | CARD | OTHER
  note        String?
  paidAt      DateTime @default(now())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([businessId, paidAt])
  @@index([saleId])
  @@index([expenseId])
}

// ---------------------------------------------------------------------------
// Phase 07 — Copilot transcript persistence (r10 rec #1).
// Conversations follow the user ACROSS DEVICES: scoped per (business, user) —
// a user's questions are their own, never shared across members. The client
// localStorage store remains the offline/fallback cache; the server copy is
// NOT financial authority (answers are recomputed on every ask — A11-A13).
// Session ids are client-generated (validated format) so local↔server
// reconciliation is identity-based and idempotent.
// ---------------------------------------------------------------------------

model ChatSession {
  id          String        @id // client-generated (s-<random>), format-validated
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        @default("") // auto-title from first question (≤80 chars)
  // User renamed via PATCH — after this the auto-title never overwrites it.
  titleEdited Boolean       @default(false)
  // Pinned conversations sort first in the history list (UI-only affordance).
  pinned      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@unique([businessId, userId, id]) // defense in depth: id alone is never enough
  @@index([businessId, userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // USER | ASSISTANT (validated in the API schema)
  role      String
  content   String // capped at 8000 chars server-side
  failed    Boolean     @default(false) // failed attempts stay LOCAL-only (never synced)
  // Citation provenance (server-computed CopilotMeta) as JSON — answers
  // restored on another device still show WHERE their numbers came from.
  metaJson  String?
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Prompt 20 — PLATFORM BILLING FOUNDATION (subscription + entitlement domain).
//
// SEPARATION LAW (docs/billing/platform-billing-vs-business-finance.md):
// these tables model the SaaS subscription of a business TO THIS PLATFORM.
// They must never be mixed with tenant business finance (Sale/Expense/
// Payment), which records the business's OWN customers' money.
//
// Modeling notes:
// - SQLite has no enums → status/type/period/billingPeriod are strings;
//   the authoritative value sets + transition rules live in
//   src/lib/billing/state-machine.ts and are validated at every boundary.
// - Subscription belongs to the BUSINESS (tenant), never to a User (§3).
// - One current subscription per business: unique(businessId) at the DB
//   level (§79). History is preserved via SubscriptionEvent rows; ended
//   subscriptions are never deleted (§81).
// - Plan.code / EntitlementDefinition.code are STABLE machine identifiers
//   (§7/§8) — display names are never used for authorization.
// - No pricing columns anywhere (§39/§40): plan identity is not money.
//   A future payment layer adds its own price/provider tables.
// - No provider-specific ids or secrets (§84/§85) — added by a later
//   payment phase through a dedicated mapping model if justified.
// ---------------------------------------------------------------------------

model Plan {
  id          String   @id @default(cuid())
  // Stable machine identifier: FREE | STARTER | BUSINESS | PRO | ENTERPRISE.
  code        String   @unique
  name        String
  description String   @default("")
  // Retired plans are deactivated (active=false), never deleted (§80).
  active      Boolean  @default(true)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planEntitlements PlanEntitlement[]
  subscriptions    Subscription[]

  @@index([active, sortOrder])
}

model EntitlementDefinition {
  id          String  @id @default(cuid())
  // Stable machine code: CUSTOMERS_MAX | AI_COPILOT | ... (§72 — constants
  // live in src/lib/billing/catalog.ts; raw literals never scatter).
  code        String  @unique
  // LIMIT | BOOLEAN (validated against catalog at seed time).
  type        String
  // COUNT | REQUESTS | MESSAGES | MEGABYTES | BUSINESSES | USERS (LIMIT only).
  unit        String?
  description String  @default("")

  planEntitlements PlanEntitlement[]

  // NOTE: code is @unique — SQLite already maintains a unique index (§78).
}

model PlanEntitlement {
  id            String                @id @default(cuid())
  planId        String
  plan          Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlementId String
  entitlement   EntitlementDefinition @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  // LIMIT rows: the numeric limit; null = UNLIMITED (e.g. ENTERPRISE).
  // BOOLEAN rows: value stays null.
  value         Int?
  // BOOLEAN rows carry the flag; LIMIT rows are always false here.
  boolValue     Boolean               @default(false)
  createdAt     DateTime              @default(now())

  @@unique([planId, entitlementId])
  @@index([entitlementId])
}

model Subscription {
  id         String   @id @default(cuid())
  // One CURRENT subscription per business (§79). History → SubscriptionEvent.
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Deleting a plan that still has subscriptions is blocked (Restrict) —
  // retire via active=false instead (§80).
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  // TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED | PAUSED (§16/§17).
  status        String @default("ACTIVE")
  // MONTHLY | YEARLY — period duration concept only; no prices (§18).
  billingPeriod String @default("MONTHLY")

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?
  // Cancellation semantics (§44): keep access until period end.
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  endedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // CREATED | PLAN_CHANGED | TRIAL_STARTED | TRIAL_ENDED | CANCELED |
  // REACTIVATED | EXPIRED | PAUSED | RESUMED (§20) — no payment events.
  type         String
  fromStatus   String?
  toStatus     String?
  fromPlanCode String?
  toPlanCode   String?
  // Small structured payload (e.g. { source: "seed-backfill" }) — never
  // payment data; the core relationships above are relational, not JSON (§17).
  dataJson     String?
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([subscriptionId, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 21 — USAGE METERING (consumption metrics, NOT resource limits).
//
// Separation of concepts (§4):
// - RESOURCE limits (CUSTOMERS_MAX…) are DERIVED from authoritative tables
//   at check time (Prompt 20) — never duplicated here (§5/§33).
// - CONSUMPTION metrics (AI_REQUESTS / AI_MESSAGES / AI_TOKENS) accumulate
//   over a defined USAGE PERIOD aligned with the subscription billing
//   period (§7) — no cron-based resets (§10/§43): a new billing period
//   simply resolves to a new UsagePeriod row on the next metered operation
//   (lazy, race-safe §76), and historical periods are retained (§101).
//
// Modeling notes:
// - Period identity is deterministic: (businessId, start) is UNIQUE (§8).
//   `end` mirrors the subscription's currentPeriodEnd (null-safe).
// - One counter per (period, metric) (§25/§72); `used` is an INTEGER that
//   only moves through guarded atomic updates (never floats §29/§30).
// - UsageEvent rows exist ONLY for meaningful consumption (AI usage — §26);
//   idempotencyKey uniqueness ([businessId, metric, idempotencyKey]) makes
//   a network retry NEVER double-charge (§17/§18). Status: COMMITTED
//   (counts) | RELEASED (provider failed before acceptance — reconciled).
// - No prompts/responses are ever stored here (§60); only provider/model
//   identifiers and authoritative token counts when the provider exposes
//   them (§14: never fabricated).
// - No money anywhere (§62/§104): usage is not pricing; a future payment
//   phase can interpret these quantities without altering their meaning
//   (§105).
// ---------------------------------------------------------------------------

model UsagePeriod {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // The subscription whose billing period this usage belongs to. Nullable:
  // the subscription row is never deleted, but keeping the link soft avoids
  // any cascade coupling while still identifying the alignment source.
  subscriptionId String?
  // UTC boundaries aligned with the subscription billing period (§7/§37).
  start          DateTime
  end            DateTime?
  createdAt      DateTime  @default(now())

  counters UsageCounter[]
  events   UsageEvent[]

  @@unique([businessId, start])
  @@index([businessId, start])
  @@index([subscriptionId])
}

model UsageCounter {
  id            String      @id @default(cuid())
  usagePeriodId String
  usagePeriod   UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)
  // AI_REQUESTS | AI_MESSAGES | AI_TOKENS (constants in src/lib/billing/usage.ts)
  metric        String
  // Integer quantity consumed in this period (COUNT/REQUESTS/MESSAGES/TOKENS
  // semantics per metric — §29/§30). Never negative: releases are guarded.
  used          Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@unique([usagePeriodId, metric])
  @@index([metric])
}

model UsageEvent {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usagePeriodId  String
  usagePeriod    UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)
  metric         String
  quantity       Int
  // COMMITTED → consumption stands; RELEASED → provider never accepted the
  // operation and the counter was reconciled back (§20/§49/§50).
  status         String      @default("COMMITTED")
  // Correlation id of the logical user operation (server-generated UUID, or
  // a client-supplied UUID validated server-side — §16). One logical user
  // operation maps to exactly one metered event per metric (§48/§116).
  requestId      String
  // Idempotency gate: a retried operation reuses the same key and is never
  // double-charged (§17/§18). Keyed per business+metric so cross-tenant
  // collisions are impossible by construction.
  idempotencyKey String
  // Small safe metadata only (§60): provider/model identifiers and
  // authoritative token counts when the provider exposes them. NEVER the
  // prompt or the response text (§60/§103).
  metaJson       String?
  createdAt      DateTime    @default(now())

  @@unique([businessId, metric, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([usagePeriodId, metric])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Prompt 22 — PAYMENT PROVIDER ABSTRACTION (checkout sessions & payments).
//
// Separation of concerns:
// - The PROVIDER INTERFACE lives in src/lib/payments (registry + adapters).
//   Providers are code+env driven (no provider table): the sandbox "mock"
//   provider is always available for development/testing; real providers
//   only activate when their env keys exist. Unknown → fail closed.
// - PRICES are server-authoritative (src/lib/payments/pricing.ts, EUR minor
//   units) — the browser never supplies an amount; the session snapshots
//   the charged amount at creation time.
// - FULFILLMENT is the ONLY path that changes a plan through a payment:
//   a signature-verified webhook marks the session SUCCEEDED and invokes
//   the idempotent Prompt-20 changePlan(service) — never the reverse, and
//   never any client-asserted "paid" state.
//
// Lifecycle:  PENDING → SUCCEEDED | FAILED | EXPIRED | CANCELED            (terminal)
//                      ↘ RECONCILIATION_REQUIRED                            (terminal,
//   Prompt 23: amount/currency/reference discrepancies from a REAL provider
//   verification are NEVER auto-resolved and NEVER silently "failed" — the
//   discrepancy is recorded (reconciliationReason + metaJson) and the case
//   waits for operator review. See docs/billing/payment-reconciliation.md.
// ---------------------------------------------------------------------------

model CheckoutSession {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Target plan + period SNAPSHOT at creation (plan rows may later change).
  planCode      String
  billingPeriod String @default("MONTHLY")

  // Provider slug: "mock" (sandbox) today; registry-gated (fail closed).
  provider    String
  // Provider-side reference (mock_… / Zarinpal Authority / cs_live_…) —
  // unique per provider.
  providerRef String

  // Settlement currency is the PLAN CATALOG currency (EUR), independent of
  // the business display currency; amounts are integer minor units.
  amountMinor Int
  currency    String @default("EUR")

  // PENDING | SUCCEEDED | FAILED | EXPIRED | CANCELED | RECONCILIATION_REQUIRED
  status               String  @default("PENDING")
  // Prompt 23 §45 — why this session needs manual reconciliation:
  // AMOUNT_MISMATCH | CURRENCY_MISMATCH | UNKNOWN_PROVIDER_STATE | PROVIDER_TIMEOUT
  reconciliationReason String?

  // Prompt 23 §13 — pricing snapshot reference. The exact catalog version
  // whose amountMinor/currency this session froze at creation time, so a
  // later price change can never retroactively re-price an open intent.
  // Prompt 24: new sessions store the resolving PriceBook's version here and
  // the book references below; pre-Prompt-24 sessions keep the legacy value
  // ("v1-2026-09-eur") with null book refs — never reinterpreted (§67/§68).
  pricingVersion    String?
  // Prompt 24 §29/§30 — immutable price-book snapshot reference.
  priceBookId       String?
  priceBook         PriceBook? @relation(fields: [priceBookId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Denormalized readable code (EUR_STANDARD) — the session stays
  // interpretable even though ids are opaque.
  priceBookCode     String?
  // Prompt 23 §149 — which user (owner/admin) initiated this payment.
  initiatedByUserId String?

  expiresAt   DateTime
  completedAt DateTime?
  // Set when fulfillment (plan change via changePlan) has been applied.
  fulfilledAt DateTime?

  // Small safe metadata only (never card data — the abstraction never
  // touches payment instruments; providers handle those).
  metaJson  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@unique([provider, providerRef])
  @@index([businessId, createdAt])
  @@index([status, expiresAt])
}

model PaymentTransaction {
  id                String          @id @default(cuid())
  checkoutSessionId String
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  provider          String
  // Provider event id — the idempotency anchor: a retried/duplicated
  // webhook can never produce two money records for the same event.
  providerEventId   String
  // SUCCEEDED | FAILED | REFUNDED (refunds out of MVP scope — reserved).
  status            String
  amountMinor       Int
  currency          String          @default("EUR")
  processedAt       DateTime        @default(now())
  metaJson          String?

  @@unique([provider, providerEventId])
  @@index([checkoutSessionId])
  @@index([processedAt])
}

// Webhook replay protection: every provider event id is recorded exactly
// once, inside the same transaction as its side effects (best-effort
// insert-with-catch → duplicate deliveries short-circuit before any state
// mutation).
model ProcessedWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  eventType  String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Prompt 24 — currency-aware pricing (price books + versioned plan prices).
//
// A PriceBook is a complete, versioned pricing catalog for ONE settlement
// currency; PlanPrice rows are its immutable per-plan/per-period amounts.
// Rules baked into this schema (docs/billing/pricing-architecture.md):
// - Price changes create a NEW PriceBook version row — PlanPrice amounts are
//   never mutated after creation (§8/§36: no retroactive repricing).
// - A book that any CheckoutSession references can NEVER be deleted
//   (CheckoutSession.priceBookId is onDelete: Restrict) — history is kept.
// - Resolution picks the newest ACTIVE, currently-effective book per
//   currency (effectiveFrom/effectiveTo, server time only — §9/§33).
// - Amounts are INTEGER minor units in the book's currency exponent
//   (EUR=2 cents, IRR=0 rials) — never floats (§22/§23).
// ---------------------------------------------------------------------------

model PriceBook {
  id            String    @id @default(cuid())
  // Stable commercial code — never encodes prices inside the code (§70).
  // EUR_STANDARD | IRR_IRAN | (harness-only: *_TEST books).
  code          String
  // Readable, unique version per code (§69): v1-2026-09 …
  version       String
  // ISO 4217 settlement currency — validated against the currency metadata
  // layer (src/lib/payments/currency.ts) at seed and resolution time.
  currency      String
  // Only active books participate in resolution (§10 step 4).
  active        Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  // Books expire automatically after effectiveTo (§9/§33).
  effectiveTo   DateTime?
  description   String    @default("")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  prices           PlanPrice[]
  checkoutSessions CheckoutSession[]

  @@unique([code, version])
  @@index([currency, active])
}

model PlanPrice {
  id            String    @id @default(cuid())
  priceBookId   String
  priceBook     PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  // Plan identity stays FREE|STARTER|BUSINESS|PRO|ENTERPRISE — prices are
  // separate rows, never new plan codes (§6: no STARTER_EUR / STARTER_IRR).
  planCode      String
  // MONTHLY | YEARLY — explicit rows for each period; yearly amounts are
  // stored, never computed from monthly at runtime (§21/§61).
  billingPeriod String
  // Integer minor units of the book currency. Positive for purchasable
  // plans; FREE/ENTERPRISE have NO rows at all (§38/§39).
  amountMinor   Int
  // Retiring a single plan's price deactivates the row — amounts are never
  // edited (§104).
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceBookId, planCode, billingPeriod])
  @@index([priceBookId, active])
}

// ---------------------------------------------------------------------------
// Prompt 25 — commercial conversion events (funnel analytics, INTERNAL).
//
// Server-authoritative conversion tracking for the pricing→signup→business→
// trial funnel. Data-minimization rules (docs/marketing/conversion-events.md):
// - eventType comes ONLY from the fixed directory (COMMERCIAL_EVENT_TYPES in
//   src/lib/billing/events.ts) — arbitrary names are rejected at the API.
// - ALLOWED payload dimensions: planCode/billingPeriod/currency/locale/
//   source/route (+ identities). NEVER emails, customer data, AI prompts,
//   payment data or raw IPs.
// - anonymousSessionKey is a server-issued random cookie UUID for public
//   visitors — never a browser fingerprint. userId/businessId are set from
//   the authenticated session only, never from the request body.
// - dedupeKey gives lifecycle-once events (e.g. ONBOARDING_COMPLETED per
//   business) a real unique constraint; nullable keys never collide, so
//   repeatable events stay repeatable.
// - Timestamps are ALWAYS server-generated — the browser is never the time
//   authority (§Prompt25: server-authoritative conversion events).
// ---------------------------------------------------------------------------

model CommercialEvent {
  id                  String   @id @default(cuid())
  // Fixed directory value only (validated at every write path).
  eventType           String
  anonymousSessionKey String?
  userId              String?
  businessId          String?
  // Optional commercial dimension — allowlisted enum values only.
  planCode            String?
  billingPeriod       String?
  currency            String?
  source              String?
  route               String?
  // Server-generated idempotency anchor (e.g. `businessId` for the one-time
  // ONBOARDING_COMPLETED event). Null → not idempotency-gated.
  dedupeKey           String?
  createdAt           DateTime @default(now())

  @@unique([eventType, dedupeKey])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousSessionKey, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 26 — AI COST GOVERNANCE (provider cost ledger, unit economics).
//
// HARD DOMAIN SEPARATION (docs/ai/ai-cost-architecture.md):
//   CUSTOMER PRICE (Plan/PlanPrice/PricingService)
//     != AI PROVIDER COST (AiCostRate/AiCostRecord).
//   Neither is ever inferred from the other. No FX. No estimated cost.
//
// Precision model (§21):
//   1 currency MINOR unit = 1,000,000 NANO-MINOR units. Rates and costs are
//   BigInt nano-minor — NEVER floats, never JavaScript `number` money.
//
// Honesty model (§32/§33/§163):
//   UNKNOWN cost = NULL amount + status UNKNOWN + a stable unknownReason.
//   UNKNOWN is NEVER zero and never estimated. Historical usage keeps cost
//   UNKNOWN until a VERIFIED rate exists for its exact usage timestamp.
//
// Idempotency (§15/§31): usageEventId UNIQUE and (businessId, requestId)
// UNIQUE — a replayed attribution can never double-count cost.
// ---------------------------------------------------------------------------

model AiCostRate {
  id                       String    @id @default(cuid())
  // Provider slug (e.g. "z-ai") — the provider abstraction identifier.
  provider                 String
  // EXACT model identifier as reported by the provider, or the explicit
  // reserved mapping "DEFAULT" (only where provider semantics make it
  // legitimate — never a fuzzy fallback, §33/§106).
  model                    String
  // ISO 4217 pricing currency of the RATE (provider pricing currency —
  // never assumed equal to business or settlement currency, §24).
  currency                 String
  // Immutable human version id (e.g. "2026-09-v1"). New price → new version.
  version                  String
  // nano-minor units per 1K tokens (1 minor unit = 1,000,000 nano-minor).
  inputRateNanoMinorPer1K  BigInt
  outputRateNanoMinorPer1K BigInt
  // Effective window (UTC). usageTimestamp decides which version applies —
  // no retroactive application of later rates (§104).
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  // Deactivation only — used rates are never deleted (§12).
  active                   Boolean   @default(true)
  // TEST | PRODUCTION — completely separate domains (§6).
  environment              String
  // Production verification evidence (§8): a PRODUCTION rate is unusable
  // for attribution without ALL three fields set.
  verifiedAt               DateTime?
  verifiedBy               String?
  sourceReference          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, model, currency, version, environment])
  @@index([provider, model, environment, active, effectiveFrom, effectiveTo])
  @@index([currency, environment, active])
}

model AiCostRecord {
  id                       String  @id @default(cuid())
  // The authoritative usage event this cost belongs to (Prompt 21 ledger).
  usageEventId             String  @unique
  // Logical AI operation correlation (Prompt 21 requestId semantics).
  requestId                String
  businessId               String
  usagePeriodId            String?
  // Plan snapshot AT USAGE TIME (§25) — later plan changes never rewrite it.
  planCodeAtUsage          String
  provider                 String
  model                    String
  // Snapshot of the resolved rate (§13) — reconstructs the calculation even
  // if the rate row is later deactivated. Null for UNKNOWN-without-rate.
  currency                 String?
  rateId                   String?
  rateVersion              String?
  environment              String?
  inputRateNanoMinorPer1K  BigInt?
  outputRateNanoMinorPer1K BigInt?
  // Normalized token snapshot (§37) — provider-independent accounting shape.
  inputTokens              Int?
  outputTokens             Int?
  totalTokens              Int?
  // COMPLETE | PARTIAL | TOTAL_ONLY | NONE (§16).
  tokenStatus              String
  // KNOWN | UNKNOWN (§17). KNOWN ⇒ costNanoMinor non-null; UNKNOWN ⇒ null.
  costStatus               String
  costNanoMinor            BigInt?
  // RATE_NOT_FOUND | MODEL_UNKNOWN | TOKENS_MISSING | PARTIAL_TOKEN_DATA |
  // CURRENCY_NOT_CONFIGURED | PROVIDER_NOT_CONFIGURED | ENVIRONMENT_MISMATCH
  // | RATE_NOT_VERIFIED | AMBIGUOUS_RATE (§18).
  unknownReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, requestId])
  @@index([businessId, createdAt])
  @@index([provider, model, createdAt])
  @@index([costStatus, createdAt])
  @@index([rateId])
  @@index([usagePeriodId])
}

model AiCostAnomaly {
  id           String   @id @default(cuid())
  // SPIKE_USAGE | SPIKE_TOKENS | SPIKE_COST | HIGH_UNKNOWN_RATIO |
  // RATE_MISSING | BUSINESS_CONCENTRATION (§65).
  type         String
  // INFO | WARNING | CRITICAL.
  severity     String
  businessId   String?
  provider     String?
  model        String?
  windowStart  DateTime
  windowEnd    DateTime
  // Metric name + exact serialized values (integer strings for counts/costs,
  // integer basis-point strings for ratios — documented per metric, §119).
  metric       String
  baseline     String?
  currentValue String?
  // OPEN | ACKNOWLEDGED | RESOLVED (§120).
  status       String   @default("OPEN")
  // Idempotent emission: one anomaly per (type, window, scope).
  dedupeKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([type, dedupeKey])
  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 28 — PLATFORM CONTROL PLANE (internal operator layer).
//
// HARD DOMAIN SEPARATION (docs/security/platform-admin-security.md):
//   TENANT domain  (User/Business/BusinessMember + tenant RBAC) is a
//   completely different authority from the PLATFORM domain. A business
//   OWNER/ADMIN/... never gains platform access; a PlatformOperator gains
//   platform access ONLY through its dedicated row + role (server-derived,
//   never client-asserted).
//
// PlatformOperator:
//  - userId is UNIQUE: one operator record per user, ever.
//  - User remains the IDENTITY authority: no email/name/password here.
//  - Deleting the User CASCADES the operator record — a deleted account can
//    never leave a privileged row behind (no orphans, no silent access).
//  - active=false instantly blocks every platform API (checked on every
//    request) WITHOUT touching the user's tenant memberships (§120).
//  - Roles: PLATFORM_SUPER_ADMIN | PLATFORM_SUPPORT | PLATFORM_BILLING |
//    PLATFORM_AI_COST | PLATFORM_SECURITY | PLATFORM_READONLY (rbac in
//    src/lib/platform/rbac.ts — never the tenant role set).
//
// PlatformAuditLog:
//  - Deliberately has NO tenant-Business foreign key: platform audit must
//    survive business deletion (§9). Target references are plain indexed
//    strings, never relations.
//  - operatorId is SetNull when the operator row disappears; the role at
//    action time is snapshotted so the record stays interpretable.
//  - Content law (§10): only allowlisted safe fields; never passwords,
//    tokens, provider secrets, full AI prompts/responses or payment
//    credentials. JSON payloads are size-bounded at write time.
// ---------------------------------------------------------------------------

model PlatformOperator {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs PlatformAuditLog[]

  @@index([role, active])
}

model PlatformAuditLog {
  id               String            @id @default(cuid())
  operatorId       String?
  operator         PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  // Role snapshot — survives operator removal (SetNull above).
  operatorRole     String?
  action           String
  entityType       String
  entityId         String?
  // Plain references (NO FK): audit outlives users/businesses on purpose.
  targetUserId     String?
  targetBusinessId String?
  reason           String?
  beforeJson       String?
  afterJson        String?
  requestId        String?
  ip               String?
  userAgent        String?
  createdAt        DateTime          @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([operatorId, createdAt])
  @@index([targetUserId])
  @@index([targetBusinessId])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Prompt 27 — LEGAL ACCEPTANCE (append-only record of policy acceptance).
//
// Honesty law (Prompt 27 §53–§58/§105/§162–§166):
//  - APPEND-ONLY: acceptedAt/documentType/documentVersion are never mutated
//    after the fact. A new policy version means a NEW row — prior accepted
//    versions are never overwritten (§54/§55).
//  - The full legal text is NEVER stored in the database — rows reference
//    documentType + version from the structured content registry (§56).
//  - IDEMPOTENT: unique (userId, documentType, documentVersion) — repeated
//    acceptance of the same version does not create duplicates (§164).
//  - Server-authoritative: userId and documentVersion are resolved by the
//    server from the session and the current content registry; the client
//    can never submit a version (§163).
//  - Lifecycle: rows cascade with the User (§166 — documented in the data
//    deletion matrix, no orphans are left behind).
// ---------------------------------------------------------------------------
model LegalAcceptance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // privacy | terms (cookies is informational and not an accepted contract).
  documentType    String
  // Deterministic version id from the content registry (e.g. "2026-09-v1").
  documentVersion String
  // UI locale at acceptance time (en | fa).
  locale          String
  // Minimal technical evidence only (§165) — nullable, never required.
  ip              String?
  userAgent       String?
  acceptedAt      DateTime @default(now())

  @@unique([userId, documentType, documentVersion])
  @@index([userId, acceptedAt])
  @@index([documentType, documentVersion])
}

// ---------------------------------------------------------------------------
// Prompt 31 — CUSTOMER DATA PORTABILITY (tenant-scoped export/import jobs).
//
// Security laws (Prompt 31 §12-§16, §61, §301-§303):
//  - Tenant-owned: every row belongs to exactly one Business and cascades
//    with it (§273 — deleting the business removes its portability jobs).
//  - `id` is a Prisma cuid (unguessable, non-sequential) — it is a job
//    identifier, NEVER an access credential (§14/§15). Download/commit
//    ALWAYS re-check session + membership + role + status + expiry.
//  - NO file content, NO secrets, NO tokens in this table — only safe
//    metadata (counts, checksums, bounded safe failure codes).
//  - Statuses are server-owned state machines (§103/§165); the client can
//    never assign them.
//  - Files live on the filesystem under the non-public portability root
//    (§11/§18/§303) — this table stores only the server-generated key.
// ---------------------------------------------------------------------------
model DataExportJob {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId  String
  // QUEUED | PROCESSING | COMPLETED | FAILED | EXPIRED | CANCELED
  status             String    @default("QUEUED")
  // JSON | CSV (CSV artifacts are ZIP packages with an embedded manifest).
  format             String
  schemaVersion      Int       @default(1)
  // JSON array of dataset keys from the export catalog (allowlisted).
  requestedDatasets  String
  // Bounded client-supplied idempotency marker (§38) — optional.
  idempotencyKey     String?
  recordCount        Int?
  fileSize           Int?
  // SHA-256 hex of the final artifact file (§21) — verified at download.
  checksum           String?
  // Server-generated relative storage key (never user-controlled, §147).
  storageKey         String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  // Stable safe failure vocabulary (§259) — never raw errors.
  failureCode        String?
  failureMessageSafe String?

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model DataImportJob {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId  String
  // customers | suppliers | products (controlled import catalog §59).
  datasetType        String
  // UPLOADED | PARSING | MAPPING_REQUIRED | VALIDATING | READY |
  // COMMITTING | COMPLETED | FAILED | EXPIRED | CANCELED (§103)
  status             String    @default("UPLOADED")
  // Display-only original file name (sanitized; never used as a path, §147).
  fileName           String
  fileSize           Int
  // Server-generated relative storage key for the staged upload (§62).
  storageKey         String?
  // SHA-256 of the staged upload — re-verified at commit (§311).
  fileChecksum       String?
  schemaVersion      Int       @default(1)
  // Validated mapping (source column -> target field) — server-validated
  // against the per-dataset allowlist (§69/§70); never raw Prisma fields.
  mappingJson        String?
  // SKIP | REJECT (deterministic duplicate policy §82; default SKIP §336).
  duplicateMode      String    @default("SKIP")
  // Commit idempotency marker (§163) — set once at commit time.
  commitToken        String?
  rowCount           Int?
  validRows          Int?
  invalidRows        Int?
  duplicateRows      Int?
  wouldCreate        Int?
  // UPDATE mode is NOT implemented in Prompt 31 (honest §388 report);
  // columns kept for schema stability — always 0/null today.
  wouldUpdate        Int?
  wouldSkip          Int?
  createdCount       Int?
  updatedCount       Int?
  skippedCount       Int?
  failedCount        Int?
  // Bounded row-level error report (MAX_IMPORT_ERRORS, §172) — codes +
  // row numbers + field names only; NO raw row values (§321/§322).
  errorReport        String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  failureCode        String?
  failureMessageSafe String?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Prompt 32 — Unified Notification Platform
// ---------------------------------------------------------------------------
// Notifications are a user-communication layer DERIVED from domain events —
// never an authority layer (§32 final principle). Everything below is
// metadata only: no secrets (passwords/OTPs/MFA secrets/reset tokens/session
// tokens/payment credentials/provider costs) may ever be stored here (§25).

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Business context is OPTIONAL (user-level security notifications have
  // none). Deleting the business removes its business-scoped notifications
  // (documented deletion policy, §200).
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Allowlisted catalog values only — validated by the notification service
  // before persistence (§5/§36). Client input can never introduce a type.
  type     String
  category String // SECURITY | BILLING | AI | BUSINESS | SYSTEM
  priority String // LOW | NORMAL | HIGH | CRITICAL
  severity String // INFO | SUCCESS | WARNING | ERROR

  // i18n KEYS — localized text is rendered at read time, never persisted
  // (§21/§22/§192). dataJson is a strict per-type server-constructed object.
  titleKey    String
  bodyKey     String
  dataJson    String?
  // Server-generated, allowlisted internal route (§102/§103) — never
  // client-supplied, never a remote URL.
  actionRoute String?

  // Server-generated idempotency/dedupe key (§28/§29): recipient + type +
  // sourceEventId is UNIQUE, so an API/domain retry cannot flood the user.
  // NULL sourceEventId (SQLite treats NULLs as distinct) = non-deduplicable
  // notification; the service always sets one for event-derived types (§30).
  sourceEventId String?
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  // Ephemeral notifications (e.g. usage warnings) may expire (§57).
  expiresAt     DateTime?

  deliveries NotificationDelivery[]

  @@unique([userId, type, sourceEventId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, archivedAt, createdAt])
  @@index([businessId, createdAt])
  @@index([type, createdAt])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // IN_APP | EMAIL (PUSH/SMS are future adapters, not implemented §9/§140).
  channel           String
  // PENDING | PROCESSING | SENT | FAILED | SKIPPED | CANCELED (§142).
  status            String    @default("PENDING")
  // Bounded retry counter (NOTIFICATION_EMAIL_MAX_ATTEMPTS, §45).
  attemptCount      Int       @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  // Safe provider reference (§47) — never SMTP credentials.
  providerMessageId String?
  // Normalized failure class (§130/§263) — never raw SMTP output.
  failureCode       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([notificationId])
  @@index([status, createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Allowlisted catalog type + channel only (§61). MANDATORY catalog
  // policies reject persistence attempts via the API (§62) — the service
  // layer, not the schema, is the enforcement point.
  notificationType String
  channel          String // IN_APP | EMAIL
  enabled          Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, notificationType, channel])
  @@index([userId, notificationType])
}

// ---------------------------------------------------------------------------
// Prompt 35 — Advanced CRM Foundation (§8/§9/§10).
//
// CRM is OPERATIONAL, NON-ACCOUNTING data:
//   - expectedValueMinor is a FORECAST, never accounting revenue; it must
//     never enter sales totals / receivables / reports / AI metrics (§1/§12).
//   - The pipeline is a FIXED code-defined vocabulary (§6/§7) — deliberately
//     NO PipelineStage table in this prompt.
//   - Soft delete via deletedAt; financial records are never touched.
// ---------------------------------------------------------------------------
model CrmLead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  companyName String?
  phone       String?
  email       String?

  source       String
  sourceDetail String?

  // Server-controlled status (closed vocabulary, §6/§22) — never client-set
  // through the generic PATCH path.
  status String @default("NEW")

  note String?

  assignedToUserId String?
  assignedToUser   User?   @relation("CrmLeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Set ONLY by the conversion transaction (§23-§26) — never by generic PATCH.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  convertedAt DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities CrmOpportunity[]

  // Prompt 36 (§4) — timeline records anchored on this lead (SetNull: the
  // lead row itself is soft-deleted, never physically removed).
  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([businessId, deletedAt])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, assignedToUserId])
  @@index([customerId])
}

model CrmOpportunity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title       String
  description String?

  leadId String?
  lead   CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Closed stage vocabulary (§6/§7); probability is an integer 0–100.
  stage          String @default("DISCOVERY")
  probabilityPct Int    @default(10)

  // FORECAST value — integer minor units (§12). NEVER accounting revenue.
  expectedValueMinor Int    @default(0)
  currencyCode       String

  expectedCloseDate DateTime?

  assignedToUserId String?
  assignedToUser   User?   @relation("CrmOpportunityAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  lostReason String?

  wonAt  DateTime?
  lostAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prompt 36 (§4) — timeline records anchored on this opportunity (SetNull).
  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([businessId, deletedAt])
  @@index([businessId, stage])
  @@index([businessId, expectedCloseDate])
  @@index([businessId, assignedToUserId])
  @@index([customerId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Prompt 36 — CRM Activities + Tasks (§4–§9).
//
// Operational, NON-accounting context: Activity = a historical business
// interaction (closed type vocabulary, §6 of prompt 36); Task = a future/
// current action (closed status/priority vocabularies + server state
// machine, §12/§13 of prompt 36). Both are soft-deleted (deletedAt),
// cascade with the business, and NEVER touch Sale/Expense/Payment/
// Receivable/Payable/Inventory aggregates (§102).
// Every row belongs to EXACTLY ONE context (customer XOR lead XOR
// opportunity — §8, enforced in the service layer).
// ---------------------------------------------------------------------------
model CrmActivity {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Closed vocabulary ACTIVITY_TYPES (§6 of prompt 36) — no arbitrary strings.
  type String

  title       String
  description String?

  // Real point in time — stored UTC (§16 of prompt 36).
  occurredAt DateTime

  // Optional integer minutes, 1–1440 (§14 of prompt 36).
  durationMinutes Int?

  // EXACTLY ONE of these three is non-null (§8 of prompt 36 — service layer
  // enforces; the DB allows nulls because SQLite/Prisma cannot express XOR).
  leadId String?
  lead   CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User   @relation("CrmActivityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, deletedAt])
  @@index([businessId, occurredAt])
  @@index([businessId, type])
  @@index([businessId, createdByUserId])
  @@index([customerId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([opportunityId, occurredAt])
}

model CrmTask {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Closed vocabularies + server state machine (§12/§13 of prompt 36).
  status   String @default("OPEN")
  priority String @default("NORMAL")

  // Optional future instant — stored UTC (§16 of prompt 36).
  dueAt DateTime?

  // Set only through the dedicated /status endpoint; non-null iff COMPLETED.
  completedAt DateTime?

  // EXACTLY ONE context (§8 of prompt 36).
  leadId String?
  lead   CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Assignee is OPTIONAL and validated against the current business's
  // active memberships (§10/§69 of prompt 36). SetNull on user deletion.
  assignedToUserId String?
  assignedToUser   User?   @relation("CrmTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User   @relation("CrmTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prompt 37 — per-task reminder configuration (tenant business data, §5).
  // reminderEnabled=true ⇒ ONE due-soon notification for the CURRENT dueAt
  // value (§6). overdueAlertEnabled=true ⇒ ONE overdue notification (§6).
  // No recurring reminders, no daily overdue spam (§6/§175). Server keeps
  // these consistent: dueAt=null ⇒ all three reset (§8). Offsets are a
  // closed vocabulary validated in src/lib/crm/task-types.ts (§7).
  reminderEnabled       Boolean @default(false)
  reminderMinutesBefore Int?
  overdueAlertEnabled   Boolean @default(false)

  @@index([businessId, deletedAt])
  @@index([businessId, status])
  @@index([businessId, priority])
  @@index([businessId, dueAt])
  @@index([businessId, assignedToUserId])
  @@index([customerId, dueAt])
  @@index([leadId, dueAt])
  @@index([opportunityId, dueAt])
}

// ---------------------------------------------------------------------------
// Prompt 41 — Supplier Purchase Orders / Procurement Commitments (§2/§6).
// PurchaseOrder = ONE procurement document per business: "the business
// intends/commits to purchase these products from this supplier under these
// commercial terms" (§4). It is a DOCUMENT, not money movement:
//   - creating/sending/confirming/closing/cancelling NEVER creates Expense,
//     Payment, Sale, InventoryAdjustment, stockQty change, statement row,
//     payable or aging balance (§110-§113 negative tests pin this).
//   - totals are procurement document totals ONLY (§31/§151) — never
//     labelled expense/payable/amount-owed/paid anywhere (§202-§204).
// Lifecycle §14/§15: DRAFT → SENT → CONFIRMED → CLOSED; DRAFT/SENT/CONFIRMED
// → CANCELLED; CLOSED/CANCELLED terminal. Server-authoritative via dedicated
// transition endpoints only — there is NO generic status PATCH (§42).
// Snapshots §11/§22/§27: supplier name, product name/sku/unit and the
// business currency are frozen at write time; history stays intelligible
// after any later rename/soft-delete/precision change.
// ---------------------------------------------------------------------------
model PurchaseOrder {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §10 — tenant-local supplier; foreign-tenant supplier ids → 404 (§48).
  // Restrict (§234): the supplier row must outlive its documents; the
  // product-facing delete path is soft-delete so Restrict never blocks it.
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // §12 — business-local unique reference, DB-enforced (concurrency-safe).
  reference String
  // §14 — closed vocabulary DRAFT|SENT|CONFIRMED|CLOSED|CANCELLED.
  status    String @default("DRAFT")

  // §22 — currency snapshot from the business at creation (never client input).
  currencyCodeAtOrder     String
  currencySymbolAtOrder   String
  decimalPrecisionAtOrder Int

  // §20 — orderedAt is an instant; expectedDate is calendar-date semantics
  // normalized to the project's UTC-midnoon rule (never local midnight).
  orderedAt    DateTime
  expectedDate DateTime?

  // §21 — optional free text (≤2000 chars); never logged in audit bodies.
  notes String?

  // §11 — historical supplier identity (survives rename/soft-delete).
  supplierNameAtOrder String

  createdByUserId String
  createdByUser   User   @relation("PurchaseOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  sentAt      DateTime?
  confirmedAt DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         PurchaseOrderLine[]
  // Prompt 42 — goods receipts recorded against this order (§23). Cascade
  // mirrors the tenant-deletion path: receipts never outlive their order.
  goodsReceipts GoodsReceipt[]
  // Prompt 48 — supplier bills invoicing this order. Restrict: the PO is
  // business-cascaded and a PO with posted bills is never user-deletable —
  // the FK only ever fires at business deletion (mirrors goodsReceipts).
  supplierBills SupplierBill[]

  @@unique([businessId, reference])
  @@index([businessId, status])
  @@index([businessId, orderedAt])
  @@index([businessId, createdAt])
  @@index([supplierId, createdAt])
}

// PurchaseOrderLine = one product commitment within a document (§24).
// A product appears AT MOST ONCE per order (§25 — DB-enforced). Money is
// integer minor units (§23/§29); totals are ALWAYS server-derived (§30),
// never client-submitted. Line snapshots (§27) are historical.
model PurchaseOrderLine {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Restrict (§234): product soft-delete keeps history; hard product delete
  // must not silently destroy procurement lines.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §28 — integer 1..1_000_000 whole units. §29 — integer 0..9_000_000_000
  // minor units (zero allowed: free/promotional items). No floats, ever.
  orderedQty     Int
  unitPriceMinor Int

  // §27 — historical product identity (never overwritten from live data).
  productNameAtOrder String
  skuAtOrder         String?
  unitAtOrder        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prompt 42 — receipt lines recorded against this PO line (§34/§14).
  goodsReceiptLines GoodsReceiptLine[]
  // Prompt 48 — bill lines invoicing this PO line. Restrict: procurement
  // history outlives any single bill document; the chain only ever fires at
  // business deletion (mirrors goodsReceiptLines).
  supplierBillLines SupplierBillLine[]

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Prompt 42 — Goods Receipts / Inventory Receiving (§4/§21).
// GoodsReceipt = "the business has PHYSICALLY RECEIVED these quantities of
// products against a confirmed purchase order". It is the second concept in
// the hierarchy PURCHASE ORDER → GOODS RECEIPT → PRODUCT STOCK →
// INVENTORY ADJUSTMENT HISTORY (§2).
//
// SEMANTIC LAW (§3/§5/§37/§38): a receipt contains NO MONEY — no totals,
// no prices, no expense, no payment, no supplier-statement/payable/aging
// row, no accounting entry. POSTING a receipt is the ONLY state that
// mutates inventory: Product.stockQty increases and one positive
// InventoryAdjustment row is created per non-zero received line (§4/§39/§45).
// DRAFT/CANCELLED receipts are pure preparation documents (§9/§10).
//
// LIFECYCLE (§7): DRAFT → POSTED | CANCELLED. There is deliberately NO
// POSTED → CANCELLED (reversal workflow is out of scope) — a POSTED
// receipt is immutable historical inventory evidence (§8).
// ---------------------------------------------------------------------------
model GoodsReceipt {
  id String @id @default(cuid())

  // §22 — tenant scope is ALWAYS the authenticated membership, never client
  // input. Cascade mirrors every other tenant document: deleting the
  // business removes its receipts (business-level deletion is the only
  // hard-delete path — receipts have no user-facing delete §10).
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §23 — exactly one purchase order; §11 — only CONFIRMED orders accept
  // new receipts. Cascade keeps tenant deletion possible (§143): the PO is
  // itself business-cascaded, and a PO containing posted receipts is never
  // user-deletable (§145) — the FK only ever fires at business deletion.
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // §59 — business-local unique reference, DB-enforced (concurrency-safe:
  // duplicate inserts lose the race with a constraint error → 409).
  reference String
  // §7 — closed vocabulary DRAFT|POSTED|CANCELLED. Transitions are
  // server-authoritative through the dedicated post/cancel endpoints.
  status    String @default("DRAFT")

  // §25 — supplier identity snapshot copied from the PO's ALREADY-FROZEN
  // supplierNameAtOrder (never the live Supplier.name — the supplier may
  // later rename or soft-delete; history must stay readable).
  supplierNameAtReceipt           String
  // §24 — PO reference snapshot at receipt creation.
  purchaseOrderReferenceAtReceipt String

  // §62 — optional free text (≤2000 chars); document data only — never
  // logged to audit bodies, never sent to AI, never indexed into search.
  notes String?

  createdByUserId String
  createdByUser   User   @relation("GoodsReceiptCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §74 — postedAt is server-generated UTC at the post transition; never
  // client-controlled. cancelledAt mirrors it for the cancel transition.
  postedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines   GoodsReceiptLine[]
  // Prompt 43 — returns created FROM this receipt (§13/§14). Cascade mirrors
  // the tenant-deletion path: a return never outlives its source receipt.
  returns GoodsReturn[]

  @@unique([businessId, reference])
  // §179 — list/filter/query indexes.
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, postedAt])
  @@index([businessId, purchaseOrderId])
}

// GoodsReceiptLine = one product physically received within a receipt
// document (§26). A PO line appears AT MOST ONCE per receipt (§27 —
// DB-enforced) but MAY appear across many different receipts (§14 —
// partial receiving). receivedQty is a whole-unit integer ≥ 1 (§17/§18);
// a receipt contains NO price columns (§37/§38).
model GoodsReceiptLine {
  id String @id @default(cuid())

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  // §34 — the PO line is the quantity authority (orderedQty, remaining);
  // deleting the PO (business cascade) removes the receipt lines too.
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  // §30 — the product row is the operational stock authority (posting
  // updates Product.stockQty). Restrict mirrors PurchaseOrderLine: product
  // soft-delete keeps history; a hard product delete can never silently
  // destroy receiving evidence.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §17/§18 — integer 1..GOODS_RECEIPT_QTY_MAX whole units. No floats.
  receivedQty Int

  // §28/§29 — historical product identity copied from the PO LINE
  // snapshot (never the live Product row — silent history drift avoided).
  productNameAtReceipt String
  skuAtReceipt         String?
  unitAtReceipt        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prompt 43 — return lines that returned units of THIS receipt line
  // (§29 — the same receipt line may be returned across many documents).
  returnLines GoodsReturnLine[]

  // §27 — at most once per receipt document…
  @@unique([goodsReceiptId, purchaseOrderLineId])
  // §179 — …but many receipts per PO line need the reverse index.
  @@index([purchaseOrderLineId])
  @@index([productId])
  @@index([goodsReceiptId])
}

// ---------------------------------------------------------------------------
// Prompt 43 — Goods Returns / Supplier Returns (§2/§24).
// GoodsReturn = "the business has PHYSICALLY RETURNED these quantities of
// products to the supplier, sourced from one previously POSTED receipt".
// It is the third concept in the hierarchy PURCHASE ORDER → GOODS RECEIPT →
// GOODS RETURN → PRODUCT STOCK → INVENTORY ADJUSTMENT HISTORY (§4/§5).
//
// SEMANTIC LAW (§4/§6/§7): a return is a PHYSICAL INVENTORY OUTFLOW ONLY.
// Posting DECREASES Product.stockQty and creates ONE NEGATIVE
// InventoryAdjustment per line (delta = -returnedQty). It NEVER creates an
// Expense, Payment, Sale, Credit Note, supplier-statement movement,
// payable/aging row or any accounting entry (§7). It contains NO MONEY.
//
// RECEIPT IMMUTABILITY (§8): a return NEVER mutates its source receipt —
// GoodsReceipt.status, receivedQty, snapshots and lines stay frozen forever;
// returned quantities live ONLY here (§34/§126/§130 — no PARTIALLY_RETURNED
// receipt status, no receipt rewrite).
//
// LIFECYCLE (§9): DRAFT → POSTED | CANCELLED. There is deliberately NO
// POSTED → CANCELLED — a POSTED return is immutable historical inventory
// evidence (§11); CANCELLED is terminal (§12).
// ---------------------------------------------------------------------------
model GoodsReturn {
  id String @id @default(cuid())

  // §25 — tenant scope is ALWAYS the authenticated membership, never client
  // input. Cascade mirrors every other tenant document.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §13/§14 — exactly ONE source receipt per return (multiple lines from
  // that one receipt are allowed; combining receipts is not). The receipt
  // must be POSTED at create AND at post time. Cascade mirrors P42: the
  // receipt is business-cascaded, so the FK only ever fires at business
  // deletion (§120 — no user-facing delete for either document).
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  // §19 — business-local unique reference, DB-enforced (concurrency-safe:
  // duplicate inserts lose the race with a constraint error → 409 §21).
  reference String
  // §9 — closed vocabulary DRAFT|POSTED|CANCELLED. Transitions are
  // server-authoritative through the dedicated post/cancel endpoints.
  status    String @default("DRAFT")

  // §16 — supplier identity snapshot copied from the receipt's
  // ALREADY-FROZEN supplierNameAtReceipt (never the live Supplier.name —
  // rename/soft-delete must not rewrite return history §31).
  supplierNameAtReturn           String
  // §17 — receipt reference snapshot at return creation (historical
  // readability must not depend exclusively on a live relation §31).
  goodsReceiptReferenceAtReturn  String
  // §18 — PO reference snapshot copied from the receipt's
  // purchaseOrderReferenceAtReceipt. Snapshot only — never client-authored.
  purchaseOrderReferenceAtReturn String

  // §22 — optional free text (≤2000 chars); document data only — never
  // logged to audit bodies, never sent to AI, never indexed into search.
  notes String?

  createdByUserId String
  createdByUser   User   @relation("GoodsReturnCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §43 step 19 — postedAt is server-generated UTC at the post transition;
  // never client-controlled. cancelledAt mirrors it for the cancel
  // transition (DRAFT-only, §12).
  postedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines GoodsReturnLine[]

  @@unique([businessId, reference])
  // §119 — list/filter/query indexes.
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, postedAt])
  @@index([businessId, goodsReceiptId])
}

// GoodsReturnLine = one product physically returned within a return
// document (§27). A receipt LINE appears AT MOST ONCE per return (§29 —
// DB-enforced) but MAY appear across many different returns (§29/§35 —
// partial returns). returnedQty is a whole-unit integer ≥ 1 (§32);
// a return contains NO price columns (§7). Snapshots (§30) are copied
// from the SOURCE GoodsReceiptLine's ALREADY-FROZEN snapshot columns —
// never from the live Product row (§30/§31).
model GoodsReturnLine {
  id String @id @default(cuid())

  goodsReturnId String
  goodsReturn   GoodsReturn @relation(fields: [goodsReturnId], references: [id], onDelete: Cascade)

  // §28 — the source receipt line is the immutable quantity authority
  // (receivedQty §34). Cascade mirrors GoodsReceiptLine→PurchaseOrderLine:
  // the chain only ever fires at business deletion (§120).
  goodsReceiptLineId String
  goodsReceiptLine   GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)

  // §28/§47 — the product derives from GoodsReceiptLine.productId (NEVER
  // client authority). Restrict mirrors P42: product soft-delete keeps
  // history; a hard product delete can never silently destroy return
  // evidence.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §32 — integer 1..GOODS_RETURN_QTY_MAX whole units. No floats.
  returnedQty Int

  // §23 — closed vocabulary DAMAGED|WRONG_ITEM|QUALITY_ISSUE|EXCESS|OTHER
  // (SQLite has no Prisma enums; validated with zod at every boundary).
  reasonCode String

  // §30 — historical product identity copied from the RECEIPT LINE
  // snapshot (never the live Product row — silent history drift avoided,
  // §31 — history stays readable across renames/soft-deletes).
  productNameAtReturn String
  skuAtReturn         String?
  unitAtReturn        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §29 — at most once per return document…
  @@unique([goodsReturnId, goodsReceiptLineId])
  // §119 — …but many returns per receipt line/product need reverse indexes.
  @@index([goodsReceiptLineId])
  @@index([productId])
  @@index([goodsReturnId])
}

// Prompt 44 — GoodsDispatch = "the business has PHYSICALLY DISPATCHED these
// quantities of products out of stock" (to a customer or otherwise out the
// door). It is an INVENTORY OUTFLOW document — NOT an invoice, NOT a sale
// record, NOT money of any kind. Posting DECREASES Product.stockQty and
// writes ONE negative InventoryAdjustment per line; drafts and cancellations
// mutate nothing. This is the outbound mirror of P42 receipts / P43 returns.
model GoodsDispatch {
  id String @id @default(cuid())

  // §tenant — scope is ALWAYS the authenticated membership, never client
  // input. Cascade mirrors every other tenant document.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §link — an OPTIONAL customer association. SetNull: deleting the
  // customer must never destroy dispatch history; the name snapshot below
  // keeps the row readable regardless.
  customerId             String?
  customer               Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // §snapshot — customer identity frozen at creation from the linked
  // Customer (empty string when the dispatch has no customer). Renames or
  // deletions never rewrite dispatch history.
  customerNameAtDispatch String    @default("")

  // §reference — business-local unique reference, DB-enforced (duplicate
  // inserts lose the race with a constraint error → 409).
  reference String
  // §lifecycle — closed vocabulary DRAFT|POSTED|CANCELLED. Transitions are
  // server-authoritative through the dedicated post/cancel endpoints;
  // POSTED is immutable, CANCELLED is terminal.
  status    String @default("DRAFT")

  // §notes — optional free text (≤2000 chars); document data only — never
  // logged to audit bodies, never sent to AI, never indexed into search.
  notes String?

  // Prompt 45 (§32/§35) — OPTIONAL order-fulfillment link. SetNull: the
  // dispatch document outlives its sales order (tenant cascade only).
  // A standalone P44 dispatch keeps salesOrderId NULL — the two paths stay
  // explicit (P45 §7), and a linked dispatch is the ONLY document whose
  // POST decrements stock against the order's remaining quantity.
  // NOT unique: §3/§39 — ONE order is fulfilled by MANY dispatches.
  salesOrderId                  String?
  salesOrder                    SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  // §35 — order reference snapshot at dispatch creation (historical
  // readability must not depend exclusively on a live relation).
  salesOrderReferenceAtDispatch String?

  createdByUserId String
  createdByUser   User   @relation("GoodsDispatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §posting — server-generated UTC timestamps; never client-controlled.
  postedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines GoodsDispatchLine[]

  @@unique([businessId, reference])
  // §indexes — list/filter/query indexes.
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, postedAt])
  @@index([businessId, customerId])
  // Prompt 45 — order-fulfillment lookups (§90 dispatch history).
  @@index([salesOrderId])
}

// GoodsDispatchLine = one product physically dispatched within a dispatch
// document. The PRODUCT ITSELF is the source (outbound flows are not always
// chained to a purchase order), so snapshots are copied from the live
// Product row at line-add time and never refreshed afterwards.
model GoodsDispatchLine {
  id String @id @default(cuid())

  goodsDispatchId String
  goodsDispatch   GoodsDispatch @relation(fields: [goodsDispatchId], references: [id], onDelete: Cascade)

  // §product — Restrict mirrors P42/P43: product soft-delete keeps history;
  // a hard product delete can never silently destroy dispatch evidence.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §qty — integer 1..GOODS_DISPATCH_QTY_MAX whole units. No floats.
  qty Int

  // §reason — closed vocabulary SALE|GIFT_SAMPLE|TRANSFER_OUT|OTHER
  // (SQLite has no Prisma enums; validated with zod at every boundary).
  reasonCode String

  // §snapshot — historical product identity copied from the Product row at
  // line-add time (never re-read live afterwards — history stays readable
  // across renames/soft-deletes).
  productNameAtDispatch String
  skuAtDispatch         String?
  unitAtDispatch        String?

  // Prompt 45 (§32/§41) — OPTIONAL source-order line for ORDER-BASED
  // fulfillment. SetNull mirrors the dispatch→order link. For a linked
  // line the PRODUCT derives from this SalesOrderLine (never client
  // authority §41) and the snapshots above are copied from the ORDER
  // LINE's frozen snapshot (§33) instead of the live Product row.
  // NOT unique: §39 — one order line is fulfilled across MANY dispatches.
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §line-law — at most one line per product per dispatch document…
  @@unique([goodsDispatchId, productId])
  // §indexes — …but many dispatch lines per product need reverse indexes.
  // Prompt 45 — fulfillment lookups aggregate POSTED quantities per order
  // line and per order (§36/§40), so both link columns are indexed.
  @@index([productId])
  @@index([goodsDispatchId])
  @@index([salesOrderLineId])
}

// ---------------------------------------------------------------------------
// Prompt 45 — Sales Orders / Order-Based Fulfillment (§3/§8).
// SalesOrder = "the customer committed to buying these quantities at these
// prices". It is a COMMERCIAL document: NOT revenue, NOT an invoice, NOT a
// payment, NOT a stock movement (§4). Confirming an order mutates NOTHING
// but the order itself (§30) — no stock reservation exists (§101).
//
// ORDER-TO-CASH LAW (§5): in the order-based path the inventory decrement
// authority is the linked GoodsDispatch POST (exactly once, §45) and the
// financial/receivable authority is the ONE linked Sale invoice (§52/§57),
// which must NEVER decrement stock a second time (§58).
//
// LIFECYCLE (§15/§16): DRAFT → CONFIRMED → COMPLETED, with DRAFT/CONFIRMED
// → CANCELLED. COMPLETED and CANCELLED are terminal. Status is the
// commercial lifecycle only — Sale.status (payment state) stays a
// separate concept (§15/§64).
// ---------------------------------------------------------------------------
model SalesOrder {
  id String @id @default(cuid())

  // §10 — tenant scope is ALWAYS the authenticated membership, never
  // client input. Cascade mirrors every other tenant document.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §11 — OPTIONAL customer (cash/anonymous orders allowed, mirroring the
  // Sale convention). SetNull: the frozen customerNameAtOrder snapshot
  // keeps the order readable after the live relation detaches (§12).
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // §12 — customer identity frozen at creation (empty string when the
  // order has no customer). Renames/soft-deletes never rewrite it.
  customerNameAtOrder String    @default("")

  // §13/§14 — business-local unique reference, DB-enforced (concurrency
  // safe: duplicate inserts lose the race with a constraint error → 409).
  reference String
  // §15 — closed vocabulary DRAFT|CONFIRMED|COMPLETED|CANCELLED. This is
  // the commercial-order lifecycle, NEVER the Sale payment status.
  status    String @default("DRAFT")

  // §25 — currency snapshot from the business at creation (never client
  // input); historical order display always uses this snapshot.
  currencyCodeAtOrder     String
  currencySymbolAtOrder   String
  decimalPrecisionAtOrder Int

  // §8/§26 — orderDate is calendar-date semantics normalized with the
  // established UTC-midnoon rule; expectedDate is optional and calendar
  // scoped. Both are validated strict calendar dates at the boundary.
  orderDate    DateTime
  expectedDate DateTime?

  // §23 — order-level discount, integer minor units 0..subtotalMinor.
  // No tax engine, no shipping charges, no payment fields (§23).
  discountMinor Int @default(0)

  // §26 — optional free text (≤2000 chars); document data only — never
  // logged to audit bodies, never sent to AI, never indexed into search.
  notes String?

  createdByUserId String
  createdByUser   User   @relation("SalesOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §16 — lifecycle timestamps are server-generated inside the write
  // transaction; never client-controlled.
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines             SalesOrderLine[]
  // Prompt 45 (§32) — fulfillment dispatches recorded against this order.
  goodsDispatches   GoodsDispatch[]
  // §52 — the ONE order-linked invoice (one-to-one, unique on Sale side).
  sale              Sale?
  // Prompt 47 (§7) — the ONE authoritative source-quotation relation when
  // this order was converted from an accepted quotation. Nullable: every
  // legacy/direct order keeps sourceQuotationId NULL. The UNIQUE constraint
  // is the DATABASE authority behind "one quotation → at most one order"
  // (§7/§13) — a losing concurrent conversion is a constraint violation,
  // never a second order. SetNull mirrors the document chain (a business
  // cascade removes both sides; the order itself is never destroyed by the
  // quotation domain, and the quotation domain offers no delete API).
  sourceQuotationId String?
  sourceQuotation   SalesQuotation?  @relation("SalesOrderSourceQuotation", fields: [sourceQuotationId], references: [id], onDelete: SetNull)

  @@unique([businessId, reference])
  @@unique([sourceQuotationId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, orderDate])
  @@index([customerId])
}

// SalesOrderLine = one product commitment within an order (§9). A product
// appears AT MOST ONCE per order (§19 — DB-enforced). orderedQty is an
// integer 1..1,000,000 (§18); unitPriceMinor is the AGREED order price
// (§21 — persisted once, never silently re-derived from the live Product).
// Snapshots (§9/§20) are copied from the tenant-scoped Product at line-add
// time and never overwritten; the client can never author them.
model SalesOrderLine {
  id String @id @default(cuid())

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  // §20 — Restrict mirrors P41–P44: product soft-delete keeps history; a
  // hard product delete can never silently destroy order evidence.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §18/§21 — integer 1..1_000_000 whole units; integer 0..9_000_000_000
  // minor units (zero allowed: free/promotional items). No floats, ever.
  orderedQty     Int
  unitPriceMinor Int

  // §9 — historical product identity (never overwritten from live data;
  // the client never submits these as authoritative values §20).
  productNameAtOrder String
  skuAtOrder         String?
  unitAtOrder        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prompt 45 (§32) — dispatch lines fulfilling THIS order line (the
  // dispatch→order-line link; SetNull mirrors the document chain).
  goodsDispatchLines GoodsDispatchLine[]

  // §19 — at most one line per product per order…
  @@unique([salesOrderId, productId])
  // §indexes — …but many order lines per product need the reverse index.
  @@index([salesOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Prompt 47 — SALES QUOTATIONS: formal price offers to prospective or
// existing customers. A quotation is a COMMERCIAL OFFER document — NOT an
// order, NOT revenue, NOT an invoice, NOT a payment, NOT a receivable, NOT
// an inventory movement, NOT a stock reservation, NOT an accounting entry
// (§1). Lifecycle (§8): DRAFT → SENT → ACCEPTED → CONVERTED, with
// DRAFT/SENT → CANCELLED, SENT → REJECTED|EXPIRED, and ACCEPTED →
// CANCELLED permitted before conversion. Creating, editing, sending,
// accepting, rejecting, cancelling, expiring or converting a quotation
// NEVER alters inventory and NEVER creates a financial transaction (§1).
// The ONLY downstream effect of conversion is one legitimate linked
// CONFIRMED SalesOrder (§13) through the authoritative unique relation.
// ---------------------------------------------------------------------------
model SalesQuotation {
  id String @id @default(cuid())

  // §5/§2.4 — tenant scope is ALWAYS the authenticated membership, never
  // client input. Cascade mirrors every other tenant document.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §5 — OPTIONAL customer. SetNull: the frozen customerNameAtQuotation
  // snapshot keeps the quotation readable after the live relation detaches
  // (§12 — same law as SalesOrder.customerId).
  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // §12 — customer identity frozen at creation (empty string when the
  // quotation has no customer). Renames/soft-deletes never rewrite it.
  customerNameAtQuotation String    @default("")

  // §5/§10 — business-local unique reference (QT- prefix), DB-enforced;
  // quotation references are unique within their OWN business+document
  // domain and share NO sequence with SalesOrder (§10).
  reference String
  // §8 — closed vocabulary DRAFT|SENT|ACCEPTED|REJECTED|EXPIRED|CANCELLED|
  // CONVERTED. This is the offer lifecycle, never a payment status. An
  // unknown persisted value is an integrity failure — never silently DRAFT.
  status    String @default("DRAFT")

  // §5/§10 — currency snapshot from the business at creation (never client
  // input); historical quotation display always uses this snapshot.
  currencyCodeAtQuotation     String
  currencySymbolAtQuotation   String
  decimalPrecisionAtQuotation Int

  // §9 — quotationDate and validUntilDate are strict calendar dates
  // normalized with the established UTC-midnoon rule. Validity law: the
  // offer is valid THROUGH validUntilDate (inclusive) in the authenticated
  // business timezone; it expires when the current business-local calendar
  // date is AFTER validUntilDate. validUntilDate < quotationDate is
  // rejected (§9). expectedDeliveryDate is optional and calendar-scoped.
  quotationDate        DateTime
  validUntilDate       DateTime
  expectedDeliveryDate DateTime?

  // §11 — quotation-level discount, integer minor units 0..subtotalMinor.
  // No tax engine, no shipping charges, no payment fields (§2.9).
  discountMinor Int @default(0)

  // §10 — customerNotes are customer-VISIBLE document data (rendered on
  // the printable offer); internalNotes are INTERNAL only — never printed,
  // never searched, never audited, never sent to AI (§10/§16/§22).
  customerNotes String?
  internalNotes String?

  createdByUserId String
  createdByUser   User   @relation("SalesQuotationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §8 — lifecycle timestamps are server-generated inside the write
  // transaction; never client-controlled. sentAt records an internal
  // user's declaration that the offer was sent OUTSIDE the application —
  // it is NOT proof of email delivery (§2.7). acceptedAt records an
  // authorized internal user's declaration of customer acceptance — NOT a
  // verified portal signature (§2.7). There is deliberately NO expiredAt
  // column: expiration is DERIVED from validUntilDate (§9) and the
  // explicit EXPIRED transition is audited.
  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  convertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines               SalesQuotationLine[]
  // §7/§13 — the ONE authoritative converted order (one-to-one through the
  // unique SalesOrder.sourceQuotationId). Null until conversion; after
  // conversion the quotation is terminal and immutable (§8).
  convertedSalesOrder SalesOrder?          @relation("SalesOrderSourceQuotation")

  @@unique([businessId, reference])
  @@index([businessId, status])
  @@index([businessId, quotationDate])
  @@index([businessId, validUntilDate])
  @@index([customerId])
}

// SalesQuotationLine = one offered product within a quotation (§6). A
// product appears AT MOST ONCE per quotation (§6 — DB-enforced, stable
// duplicate error). qty is an integer 1..1,000,000 (§6); unitPriceMinor is
// the AGREED offered price (§6 — persisted once, never silently re-derived
// from the live Product). Snapshots (§6/§12) are copied server-side from
// the tenant-scoped Product at line-add time and never overwritten; the
// client can never author them. Products are MANDATORY (catalog-backed)
// because conversion must produce legitimate SalesOrderLines (§6).
model SalesQuotationLine {
  id String @id @default(cuid())

  salesQuotationId String
  salesQuotation   SalesQuotation @relation(fields: [salesQuotationId], references: [id], onDelete: Cascade)

  // §6 — Restrict mirrors P41–P45: product soft-delete keeps history; a
  // hard product delete can never silently destroy quotation evidence.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §6/§11 — integer 1..1_000_000 whole units; integer 0..9_000_000_000
  // minor units. No tax, no shipping-fee, no payment, no stock fields.
  qty            Int
  unitPriceMinor Int

  // §6/§12 — historical product identity (never overwritten from live
  // data; the client never submits these as authoritative values).
  productNameAtQuotation String
  skuAtQuotation         String?
  unitAtQuotation        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §6 — at most one line per product per quotation…
  @@unique([salesQuotationId, productId])
  // §indexes — …but many quotation lines per product need the reverse
  // index (product quotation history, §6/§19).
  @@index([salesQuotationId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Prompt 48 — Supplier Bills / Accounts Payable Documents (§5).
//
// SupplierBill = "the supplier invoiced these product quantities at these
// unit prices against this purchase order". It is the PROCUREMENT INVOICE
// DOCUMENT and its itemized commercial detail (§4) — NOT a GoodsReceipt
// (physical receipt authority), NOT a PurchaseOrder (procurement
// commitment), NOT a GoodsReturn (physical return authority), NOT a
// Payment (settlement authority), and NOT an Expense in disguise.
//
// NO-DUPLICATE-PAYABLE LAW (§2 — the core architecture): the bill is the
// DOCUMENT authority; the linked Expense is the SOLE financial liability
// authority; Payments keep referencing the Expense; supplier statements and
// payables aging keep reading the Expense exactly once. Posting creates
// EXACTLY ONE Expense inside the posting transaction; a DRAFT/CANCELLED
// bill has NO Expense (expenseId NULL). Posting NEVER touches Product
// stock, InventoryAdjustment, GoodsReceipt, GoodsReturn, PurchaseOrder
// quantities, Payment, Sale, SalesOrder or receivables (§11).
//
// LIFECYCLE (§10): DRAFT → POSTED | CANCELLED. POSTED is immutable in this
// phase (no edit, no cancel — reversal workflow out of scope); CANCELLED is
// terminal. Transitions run ONLY through the dedicated post/cancel
// endpoints — there is NO generic status PATCH. Unknown persisted statuses
// are integrity errors, never silently DRAFT.
//
// Snapshots (§5/§6): supplier name, PO reference, currency and product
// name/sku/unit are frozen at write time from ALREADY-FROZEN PO data —
// history stays readable after any later rename/soft-delete. The supplier
// invoice reference is normalized and DB-unique per (business, supplier);
// SQLite multi-NULL semantics let bills without an invoice reference
// coexist freely.
// ---------------------------------------------------------------------------
model SupplierBill {
  id String @id @default(cuid())

  // Tenant scope is ALWAYS the authenticated membership, never client
  // input. Cascade mirrors every other tenant document.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // §5 — the billed supplier; MUST be the PO's supplier (re-checked inside
  // the posting transaction, §11 step 4). Restrict mirrors PurchaseOrder:
  // the supplier row outlives its documents; the API only soft-deletes.
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // §5/§6 — exactly ONE source purchase order. Restrict mirrors
  // GoodsReceipt→PurchaseOrder: the FK only ever fires at business
  // deletion; a posted bill never silently loses its source PO.
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  // Business-local unique reference, DB-enforced (concurrency-safe:
  // duplicate inserts lose the race with a constraint error → 409 §21).
  reference                String
  // §5 — the supplier's own invoice number (normalized, optional). Unique
  // per (business, supplier) via the composite constraint below; SQLite
  // multi-NULL semantics keep invoice-less bills conflict-free.
  supplierInvoiceReference String?

  // §5 — historical identity snapshots, frozen at write time.
  supplierNameAtBill           String
  purchaseOrderReferenceAtBill String

  // §5/§8 — currency snapshot copied from the PO's ALREADY-FROZEN order
  // currency (never client input); a differing invoice currency is
  // rejected with SUPPLIER_BILL_CURRENCY_MISMATCH (§8 — FX out of scope).
  currencyCodeAtBill     String
  currencySymbolAtBill   String
  decimalPrecisionAtBill Int

  // §10 — closed vocabulary DRAFT|POSTED|CANCELLED, parsed with the
  // integrity law (unknown → controlled 500, never DRAFT).
  status String @default("DRAFT")

  // §5 — date-only business semantics, normalized to the canonical
  // UTC-midnoon instant (Prompt-35 §84 law; the linked Expense inherits
  // both under the same normalization, §11 steps 20-21).
  billDate DateTime
  dueDate  DateTime?

  // §9 — canonical server-derived totals (integer minor units; NEVER
  // client-submitted; recomputed inside the posting transaction).
  subtotalMinor Int @default(0)
  discountMinor Int @default(0)
  totalMinor    Int @default(0)

  // §16 — staff-only free text (≤2000 chars); never logged to audit
  // bodies, never sent to AI, never indexed into search, never exported.
  internalNotes String?

  createdByUserId String
  createdByUser   User   @relation("SupplierBillCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // §10/§11 — server-generated UTC timestamps; never client-controlled.
  postedAt    DateTime?
  cancelledAt DateTime?

  // §2/§5 — THE one-to-one payable link. NULL for DRAFT/CANCELLED; exactly
  // one Expense exists for every POSTED bill (created INSIDE the posting
  // transaction, §11 steps 15-24). @unique is the database-level guarantee
  // that two bills can never share one payable (the concurrent-posting
  // loser loses this constraint → rollback → controlled conflict).
  // SetNull: the FK only ever fires at business-cascade deletion (see
  // Expense.supplierBill for the reciprocal relation).
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SupplierBillLine[]

  @@unique([businessId, reference])
  // §5 — supplier invoice references are unique per (business, supplier):
  // different suppliers MAY reuse the same invoice number (documented
  // business rule); the same supplier may not invoice the same number
  // twice. NULLs are distinct under SQLite semantics.
  @@unique([businessId, supplierId, supplierInvoiceReference])
  // List/filter/query indexes (§15).
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, billDate])
  @@index([businessId, dueDate])
  @@index([businessId, purchaseOrderId])
  @@index([businessId, supplierId])
}

// SupplierBillLine = one invoiced product quantity within a bill document
// (§6). A PO line appears AT MOST ONCE per bill (DB-enforced) but MAY
// appear across many bills while received-unbilled quantity remains (§7 —
// partial invoicing). billedQty is a whole-unit integer ≥ 1 (§6);
// unitPriceMinor is the ACTUAL supplier-invoice price entered by an
// authorized user (§8 — never silently replaced by the PO price); the PO
// unit price is snapshotted alongside for the displayed variance.
model SupplierBillLine {
  id String @id @default(cuid())

  supplierBillId String
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)

  // §6 — the PO line is the procurement product authority (the bill's
  // supplier and business must match the PO; re-verified at posting).
  // Restrict mirrors GoodsReceiptLine→PurchaseOrderLine: the chain only
  // ever fires at business deletion.
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  // §6 — the product derives from the authoritative PurchaseOrderLine
  // (NEVER client authority). Restrict: a hard product delete can never
  // silently destroy posted bill history.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // §6/§8/§9 — integer 1..1_000_000 whole units; integer 0..1_000_000_000
  // minor units. lineTotalMinor = billedQty × unitPriceMinor (BigInt math,
  // server-derived, never client-submitted).
  billedQty      Int
  unitPriceMinor Int
  lineTotalMinor Int

  // §6 — historical product identity copied from the PO LINE's
  // ALREADY-FROZEN snapshot (never the live Product row).
  productNameAtBill String
  skuAtBill         String?
  unitAtBill        String?

  // §8 — the agreed purchase-order unit price at billing time, snapshotted
  // for the displayed price variance (invoiced − PO). Never overwritten.
  purchaseOrderUnitPriceMinor Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §6 — at most once per bill document…
  @@unique([supplierBillId, purchaseOrderLineId])
  // …but many bills per PO line need the reverse index (matching + history).
  @@index([supplierBillId])
  @@index([purchaseOrderLineId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Prompt 52 — Public API keys for external accounting integrations (§F8).
// ONLY the SHA-256 hash of the key is stored; the plaintext key exists
// exclusively at creation time (shown once, never retrievable). Scope is a
// closed set validated in the service layer ("read" only in this release).
// A key belongs to exactly one business — every open-API query is filtered
// by businessId (A01/A02 tenant law). Soft-revocation via revokedAt.
// ---------------------------------------------------------------------------
model ApiKey {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name        String // display label, 1..80 chars, trimmed
  // Display prefix (first 10 chars of the plaintext) so users can tell keys
  // apart without the secret: "ck_live_ab12…"
  prefix      String
  // SHA-256 hex of the full plaintext key. UNIQUE — a leaked key rotates,
  // never duplicates.
  keyHash     String    @unique
  // Closed set, validated in the service layer. "read" = open GET surface.
  scopes      String    @default("read")
  lastUsedAt  DateTime?
  requestCount Int      @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Prompt 53 §W — Outbound webhooks for event-driven integrations.
//
// Security law (mirrors §F8 API keys):
//  - The signing secret (`whsec_<40 hex>`) exists ONLY at creation time —
//    the DB stores its SHA-256 hash; the plaintext is shown EXACTLY ONCE.
//  - An endpoint belongs to exactly ONE business; deliveries are only ever
//    dispatched for that business's events (A01/A02 tenant law).
//  - URL is validated (https in production; private ranges blocked) — no
//    SSRF pivot into the deployment's private network.
//  - Dispatch is strictly FIRE-AND-FORGET after the business transaction
//    commits: a webhook can NEVER break, delay, or roll back a sale,
//    payment, or expense (money-law safety).
//  - Deliveries are best-effort with a bounded payload (8 KiB), a 5s
//    timeout, and per-endpoint consecutive-failure tracking; 5 consecutive
//    failures auto-disable the endpoint (audited).
// ---------------------------------------------------------------------------
model WebhookEndpoint {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Delivery target. Validated in the service layer (scheme + host guard).
  url         String
  // Display prefix of the signing secret: "whsec_ab12…" (first 12 chars).
  prefix      String
  // Signing secret encrypted at rest (secret-box AES-256-GCM v1 envelope,
  // §188-§197 — the same base as MFA TOTP secrets). Plaintext exists ONLY
  // at creation time (shown once) and transiently in the delivery path.
  secretBox   String
  // Comma-separated closed event set (validated against WEBHOOK_EVENTS).
  events      String
  active      Boolean   @default(true)
  // Consecutive failed deliveries (reset on success); >=5 auto-disables.
  failureCount Int      @default(0)
  lastStatus  Int?
  lastDeliveryAt DateTime?
  createdAt   DateTime  @default(now())

  deliveries  WebhookDelivery[]

  @@index([businessId, createdAt])
}

// Delivery ledger — an honest, bounded audit of what was sent and what came
// back. Payload is stored TRUNCATED (the exact bytes are hashed into the
// signature, so the ledger is diagnostic, not a replay queue).
model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  businessId  String
  event       String
  payload     String
  status      Int?     // HTTP status (null = network/DNS/timeout error)
  ok          Boolean
  attempt     Int      @default(1)
  error       String?  // truncated transport error text
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([endpointId, createdAt])
}
