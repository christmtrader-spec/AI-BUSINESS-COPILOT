# ============================================================================
# AI Business Copilot — environment variable template (Prompt 19 §23)
# ============================================================================
# Copy to `.env` and fill in real values. NEVER commit the filled .env.
# This file contains PLACEHOLDERS ONLY — no real secrets, no test passwords.

# --- Database ---------------------------------------------------------------
# SQLite connection string (Prisma datasource). Relative paths resolve
# against prisma/schema.prisma; the project convention is an absolute file URL.
DATABASE_URL=

# --- Authentication (NextAuth v4) -------------------------------------------
# Required in production: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical origin NextAuth serves on (e.g. https://app.example.com)
NEXTAUTH_URL=

# --- Public base URL (password-reset email links) ---------------------------
# Optional in development (falls back to NEXTAUTH_URL). Set explicitly in
# production so reset links NEVER trust the incoming request Host header.
APP_BASE_URL=

# --- Email transport (Prompt 29 §7-§11 — real SMTP adapter) ------------------
# Development: the console transport prints reset links to dev.log (and
# EMAIL_PROVIDER=test-memory selects the TEST-ONLY in-memory provider — never
# resolvable in production). Production: ALL of host + port + from are
# REQUIRED together; EMAIL_SECURE must be explicitly "true" (implicit TLS,
# typical port 465) — explicit "false" is BLOCKED in production. Certificate
# verification is never disabled. Delivery is bounded by EMAIL_TIMEOUT_MS.
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
# true (implicit TLS, e.g. 465) | false (STARTTLS negotiated; explicit in prod)
EMAIL_SECURE=
# Bounded delivery timeout in ms (1000..60000, default 10000). Never unbounded.
EMAIL_TIMEOUT_MS=

# --- Payments (Prompt 23 — real provider integration) ------------------------
# Global switch. false → payment initiation returns PAYMENTS_UNAVAILABLE
# (existing subscriptions/payment history are untouched). In production the
# value MUST be exactly "true" to enable payments (no defaults).
PAYMENTS_ENABLED=
# Preferred provider slug (mock | zarinpal). When set, resolution FAILS
# CLOSED if that provider cannot start — never a silent fallback.
PAYMENT_PROVIDER=
# mock | sandbox | production (unambiguous values only; mock is
# development/test ONLY and is blocked in production).
PAYMENT_ENV=
# Canonical public origin used to build provider callback URLs. REQUIRED for
# real providers; must be HTTPS in production. Never derived from Host headers.
PAYMENT_BASE_URL=
# Prompt 24 — DEFAULT platform settlement currency for checkout/catalog
# requests that do not name one (EUR | IRR). Must be in the settlement
# allowlist. Default: EUR (the only ACTIVATED price book — switching the
# default to IRR requires an explicitly configured/activated IRR catalog).
PAYMENT_SETTLEMENT_CURRENCY=
# --- Zarinpal (real provider — sandbox/production use SEPARATE values) ------
# Zarinpal v4 merchant UUID (terminal id). SERVER-SIDE ONLY — never exposed
# to the browser, never committed filled. Placeholders only here.
ZARINPAL_MERCHANT_ID=

# --- Free trials (Prompt 25) --------------------------------------------------
# Trials are DISABLED by default (absent/unset = off). Trials are an explicit
# opt-in so no environment accidentally grants paid-plan entitlements.
# true | false (unset/anything else = disabled)
BILLING_TRIALS_ENABLED=
# Trial length in days — validated server-side to an integer 1..90.
BILLING_TRIAL_DAYS=
# The plan the trial grants (STARTER | BUSINESS | PRO). FREE/ENTERPRISE are
# never trials. Must be active/public in the authoritative plan catalog.
BILLING_TRIAL_PLAN=
# Prompt 25 — Enterprise "Contact sales" channel on the public pricing page.
# An operator-configured mailto/URL; when empty the CTA renders honestly
# disabled (no fake form, no invented address). Public (NEXT_PUBLIC) by design.
NEXT_PUBLIC_SALES_CONTACT=

# --- AI cost governance (Prompt 26) -------------------------------------------
# Attribution environment for rate resolution: TEST | PRODUCTION. When unset,
# production-like runtimes attribute as PRODUCTION and development as TEST.
# TEST and PRODUCTION rate domains are completely separate.
AI_COST_ENVIRONMENT=
# Request-level COST GUARD — master switch. Default OFF (false/unset). When
# enabled, blocking uses ONLY verified cost data and configured ceilings.
AI_COST_GUARD_ENABLED=
# Guard behavior when its own monitoring fails: true (default) = fail open
# (AI keeps working); set "false" ONLY for a deliberate strict policy.
AI_COST_GUARD_FAIL_OPEN=
# Ceilings in NANO-MINOR units (1 minor unit = 1,000,000 nano-minor) —
# integers only, no decimals. Leave empty when no ceiling is intended.
AI_COST_GUARD_MAX_PERIOD_COST_NANO_MINOR=
AI_COST_GUARD_MAX_REQUEST_COST_NANO_MINOR=
AI_COST_GUARD_WINDOW_DAYS=
# Economics gates: minimum sample size for plan economics, and minimum cost
# coverage in basis points (8000 = 80%). Server-side validated.
MIN_ECONOMICS_SAMPLE_SIZE=
MIN_COST_COVERAGE_FOR_ECONOMICS=
# Anomaly detection tuning (basis points margin, bounded windows).
AI_COST_SPIKE_MARGIN_BPS=
AI_COST_ANOMALY_WINDOW_DAYS=
AI_COST_ANOMALY_MIN_BASELINE=
# Internal cost-operator token for any future protected cost endpoint.
# NEVER committed filled; server-side only; never logged.
AI_COST_OPERATOR_TOKEN=
# AI cost governance configuration (Prompt 26; surfaced via the Prompt 28 platform console)
AI_COST_GUARD_ENABLED=
AI_COST_GUARD_MAX_PERIOD_COST_NANO_MINOR=
AI_COST_GUARD_MAX_REQUEST_COST_NANO_MINOR=
AI_COST_GUARD_WINDOW_DAYS=
AI_COST_GUARD_MAX_CURRENCY_GROUPS=
AI_COST_GUARD_FAIL_OPEN=
AI_COST_ANOMALY_WINDOW_DAYS=
AI_COST_ANOMALY_MIN_BASELINE=
AI_COST_SPIKE_MARGIN_BPS=
MIN_ECONOMICS_SAMPLE_SIZE=
MIN_COST_COVERAGE_FOR_ECONOMICS=
# NOTE (§126): NO provider token pricing belongs in this file. Provider
# commercial rates are NOT environment values — they are verified AiCostRate
# rows created through the governed rate service with evidence.

# --- Public trust / legal configuration (Prompt 27) ----------------------------
# Public legal contacts. Leave EMPTY when not configured — the public legal
# pages then render the honest "not configured" state. NEVER fill these with
# placeholder values (example.com / your-name@example.com). These are public
# contact points, not secrets — but only surface them when they are real.
PUBLIC_COMPANY_LEGAL_NAME=
PUBLIC_BASE_URL=
PUBLIC_SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=
LEGAL_CONTACT_EMAIL=
SECURITY_CONTACT_EMAIL=

# --- Observability & operations (Prompt 29) -----------------------------------
# Structured-log level: debug | info | warn | error. Production default INFO,
# development DEBUG. Never force production to query-level DB logging.
LOG_LEVEL=
# Deliberate opt-in to include stack traces in PRODUCTION server diagnostics.
# Leave EMPTY in normal production (stacks are dev-only by default).
SECURE_SERVER_DIAGNOSTICS=
# Bounded graceful-shutdown window for SIGTERM/SIGINT in ms (1000..60000,
# default 8000). The process never hangs past this cap.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=

# --- Backup / restore automation (Prompt 29 §46-§57) ---------------------------
# Backup destination directory (default: db/backups relative to the project).
# MUST NOT be web-served or committed. Keep offsite copies separately.
BACKUP_DIR=
# OPERATIONAL backup-staleness policy (hours) — readiness shows BACKUP_STALE
# when exceeded. This is NOT a legal data-retention period (§57).
BACKUP_MAX_AGE_HOURS=
# OPERATIONAL restore-drill staleness (days) — readiness shows
# RESTORE_DRILL_STALE when exceeded. Run scripts/restore-drill.mjs periodically.
RESTORE_DRILL_MAX_AGE_DAYS=
# Retention for local backup artifacts (scripts/prune-backups.mjs). These are
# OPERATIONAL backup counts — NOT legal data-retention policy.
BACKUP_RETENTION_DAILY=
BACKUP_RETENTION_WEEKLY=

# --- Identity security v2 (Prompt 30 §183-§190) ---------------------------------
# Email-verification mode: OFF | OPTIONAL | REQUIRED.
#   OFF (default)  — no verification enforcement; existing users unaffected.
#   OPTIONAL       — verification available and encouraged, accounts usable.
#   REQUIRED       — business creation / trial start / paid checkout require a
#                    verified email (§10). REQUIRED without SMTP is BLOCKED.
AUTH_EMAIL_VERIFICATION_MODE=
# MFA capability switch: "true" enables self-enrollment of TOTP MFA and the
# second factor at login for enrolled users (§184). Default off — NEVER
# silently activated for existing users (§483).
MFA_ENABLED=
# AES-256 key material (EXACTLY 32 bytes: `openssl rand -base64 32`).
# HIGHLY_SENSITIVE (§188): server-only; never log, never commit, never return.
# REQUIRED in production when MFA_ENABLED=true (§190 fail closed).
MFA_ENCRYPTION_KEY=
# MFA login-challenge TTL seconds (60..900, default 300, §47).
MFA_CHALLENGE_TTL_SECONDS=
# Recent-auth (step-up) window seconds (300..1800, default 600, §115).
MFA_STEP_UP_MAX_AGE_SECONDS=
# Per-session last-seen write throttle seconds (60..3600, default 300, §85).
SESSION_LAST_SEEN_UPDATE_SECONDS=

# --- Customer data portability (Prompt 31 §181-§184) -----------------------------
# Storage root for export artifacts + staged import uploads. MUST resolve
# OUTSIDE every web-served directory (public/, .next/, static/ are rejected).
# Default: var/data-portability (non-public, application-created).
DATA_PORTABILITY_ROOT=
# Operational file TTL in hours (1..720, default 72). This is OPERATIONAL
# cleanup ONLY — never a legal retention policy (§132/§184).
EXPORT_FILE_TTL_HOURS=
# Hard generation bounds (§24/§26): exports exceeding them FAIL with
# EXPORT_LIMIT_EXCEEDED — never a partial file labeled complete.
EXPORT_MAX_RECORDS=
EXPORT_MAX_BYTES=
EXPORT_MAX_DATASETS=
# Operational staged-upload TTL hours (1..720, default 72, §63/§133).
IMPORT_FILE_TTL_HOURS=
# Bounded upload size in bytes (default 10485760 = 10 MiB, §57).
IMPORT_MAX_BYTES=
# Stored row-level error cap (10..50000, default 500, §172).
IMPORT_MAX_ERRORS=
# Active-job concurrency caps per business (§37/§101).
MAX_ACTIVE_EXPORTS_PER_BUSINESS=
MAX_ACTIVE_IMPORTS_PER_BUSINESS=

# --- Unified notification platform (Prompt 32 §343-§345) ---------------------
# In-app notification center + transactional email. The platform introduces NO
# SMTP variables of its own — it sends through the existing EMAIL_* transport
# above (same provider, TLS policy, and EMAIL_TIMEOUT_MS contract).
# All nine values below are OPTIONAL with validated bounds; invalid values
# (non-integer/out-of-range) fall back to the documented default. These are
# OPERATIONAL tuning values — never legal retention periods.
# Email retry cap per delivery (1..10, default 3). Beyond the cap the delivery
# is terminal FAILED ATTEMPTS_EXHAUSTED.
NOTIFICATION_EMAIL_MAX_ATTEMPTS=
# Operational retention for NON-security notifications in days (7..3650,
# default 90) — applies only to read/archived/expired rows.
NOTIFICATION_RETENTION_DAYS=
# Longer operational retention for SECURITY-category notifications in days
# (30..3650, default 365) — security history is never aggressively pruned.
NOTIFICATION_SECURITY_RETENTION_DAYS=
# Hard maximum pageSize for the notification list endpoints (10..200, default
# 100); the API default page size is 20.
NOTIFICATION_MAX_PAGE_SIZE=
# Serialized per-notification data payload cap in bytes (1024..262144,
# default 32768) — oversized payloads are rejected before persistence.
NOTIFICATION_MAX_DATA_BYTES=
# Cleanup batch size for scripts/prune-expired-notifications.mjs (50..5000,
# default 500) — deletes run in bounded batches, never one unbounded statement.
NOTIFICATION_CLEANUP_BATCH_SIZE=
# A PROCESSING email delivery stuck longer than this many minutes (5..1440,
# default 30) is marked FAILED STALE_PROCESSING — never auto-resent.
NOTIFICATION_STALE_DELIVERY_MINUTES=
# Upper bound of PENDING email deliveries per user (10..1000, default 100);
# above the cap OPTIONAL emails are skipped (in-app is never suppressed;
# mandatory security email bypasses the cap).
NOTIFICATION_ACTIVE_DELIVERY_LIMIT=
# Unread-count poll interval bound for the notification bell in ms
# (10000..600000, default 45000). The client polls conservatively and pauses
# while the tab is hidden.
NOTIFICATION_POLL_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Prompt 47 — Sales Quotations
# ---------------------------------------------------------------------------
# Maximum number of product lines on ONE sales quotation (20..500, default
# 200). Write-time cap: adding a line to a quotation already at the cap is
# rejected with SALES_QUOTATION_LINE_LIMIT_REACHED; a persisted quotation
# with MORE lines than its own cap is database corruption and fails reads
# with SALES_QUOTATION_LINE_CAP_INVARIANT. Malformed/empty values fall back
# to the default — never unbounded.
SALES_QUOTATION_MAX_LINES=
