# ============================================================================
# AI Business Copilot — environment variable template (Prompt 19 §23)
# ============================================================================
# Copy to `.env` and fill in real values. NEVER commit the filled .env.
# This file contains PLACEHOLDERS ONLY — no real secrets, no test passwords.

# --- Database ---------------------------------------------------------------
# SQLite connection string (Prisma datasource). Relative paths resolve
# against prisma/schema.prisma; the project convention is an absolute file URL.
DATABASE_URL=

# --- Authentication (NextAuth v4) -------------------------------------------
# Required in production: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical origin NextAuth serves on (e.g. https://app.example.com)
NEXTAUTH_URL=

# --- Public base URL (password-reset email links) ---------------------------
# Optional in development (falls back to NEXTAUTH_URL). Set explicitly in
# production so reset links NEVER trust the incoming request Host header.
APP_BASE_URL=

# --- Email transport (reserved — Prompt 18 email abstraction) ----------------
# In development the console transport logs reset links instead of sending.
# In production, absence of EMAIL_SERVER_HOST makes password-reset request
# return 503 EMAIL_TRANSPORT_UNAVAILABLE (uniform, non-enumerating).
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# --- Payments (Prompt 23 — real provider integration) ------------------------
# Global switch. false → payment initiation returns PAYMENTS_UNAVAILABLE
# (existing subscriptions/payment history are untouched). In production the
# value MUST be exactly "true" to enable payments (no defaults).
PAYMENTS_ENABLED=
# Preferred provider slug (mock | zarinpal). When set, resolution FAILS
# CLOSED if that provider cannot start — never a silent fallback.
PAYMENT_PROVIDER=
# mock | sandbox | production (unambiguous values only; mock is
# development/test ONLY and is blocked in production).
PAYMENT_ENV=
# Canonical public origin used to build provider callback URLs. REQUIRED for
# real providers; must be HTTPS in production. Never derived from Host headers.
PAYMENT_BASE_URL=
# --- Zarinpal (real provider — sandbox/production use SEPARATE values) ------
# Zarinpal v4 merchant UUID (terminal id). SERVER-SIDE ONLY — never exposed
# to the browser, never committed filled. Placeholders only here.
ZARINPAL_MERCHANT_ID=
